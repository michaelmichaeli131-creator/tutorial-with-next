const v10Trails=[];
function v10PushTrail(x,y,color,size,life=.34){if(v10Trails.length>(isMobile?80:150))v10Trails.shift();v10Trails.push({x,y,color,size,life,max:life});}
const v10UpdateBase=update;
update=function(dt){v10UpdateBase(dt);if(!game.running||game.paused)return;for(const o of game.orbs){if((o.phase*10|0)%3===0)v10PushTrail(o.x,o.y+o.r*.45,o.type==='bomb'?'#ff4264':o.type==='shard'?'#69ffb5':worlds[game.world].enemy,Math.max(3,o.r*.18),.24);}for(const p of game.projectiles)v10PushTrail(p.x-p.vx*.025,p.y-p.vy*.025,p.color,Math.max(3,p.r*.55),.18);for(let i=v10Trails.length-1;i>=0;i--){v10Trails[i].life-=dt;if(v10Trails[i].life<=0)v10Trails.splice(i,1);}}
const v10DrawBase=draw;
draw=function(){v10DrawBase();if(!game.running)return;ctx.save();ctx.globalCompositeOperation='lighter';for(const t of v10Trails){ctx.globalAlpha=Math.max(0,t.life/t.max)*.58;const g=ctx.createRadialGradient(t.x,t.y,0,t.x,t.y,t.size*2.8);g.addColorStop(0,t.color);g.addColorStop(1,'transparent');ctx.fillStyle=g;ctx.beginPath();ctx.arc(t.x,t.y,t.size*2.8,0,Math.PI*2);ctx.fill();}ctx.restore();ctx.globalAlpha=1;};
const v10DrawScout=v9DrawScout;
v9DrawScout=function(o,color){ctx.save();const lean=Math.sin(o.phase*.9+o.variant)*.12;ctx.rotate(lean);v10DrawScout(o,color);ctx.globalCompositeOperation='lighter';ctx.fillStyle=color+'88';for(const side of [-1,1]){ctx.beginPath();ctx.moveTo(side*13,21);ctx.lineTo(side*7,42+Math.sin(o.phase*3)*5);ctx.lineTo(side*2,22);ctx.fill();}ctx.restore();};
const v10DrawHeavy=v9DrawHeavy;
v9DrawHeavy=function(o,color){ctx.save();ctx.translate(0,Math.sin(o.phase*1.2)*2);v10DrawHeavy(o,color);ctx.strokeStyle='#fff8';ctx.lineWidth=1.4;ctx.beginPath();ctx.moveTo(-14,1);ctx.lineTo(14,1);ctx.stroke();ctx.restore();};
const v10DrawBossBase=drawBoss;
drawBoss=function(b,w){ctx.save();ctx.translate(0,Math.sin(b.t*2.2)*4);v10DrawBossBase(b,w);ctx.restore();ctx.save();ctx.globalCompositeOperation='lighter';ctx.strokeStyle=w.accent+'77';ctx.lineWidth=2;for(let i=0;i<3;i++){const rr=b.r*(1.15+i*.18)+Math.sin(b.t*2+i)*8;ctx.beginPath();ctx.arc(b.x,b.y,rr,0,Math.PI*2);ctx.stroke();}ctx.restore();};
const v10BeginBase=begin;
begin=function(mode='solo',seed){v10Trails.length=0;v10BeginBase(mode,seed);audio.start();if(audio.ctx&&audio.music)audio.music.gain.setTargetAtTime(save.music/100*.42,audio.ctx.currentTime,.05);};
const v10MusicStart=audio.start.bind(audio);
audio.start=function(){v10MusicStart();if(!this.ctx)return;this.music.gain.setTargetAtTime(save.music/100*.42,this.ctx.currentTime,.08);this.sfxGain.gain.setTargetAtTime(save.sfx/100*.62,this.ctx.currentTime,.08);if(this.v10Pulse)return;const pulse=this.ctx.createOscillator(),pulseGain=this.ctx.createGain(),pulseFilter=this.ctx.createBiquadFilter();pulse.type='sine';pulse.frequency.value=2;pulseGain.gain.value=.0001;pulseFilter.type='lowpass';pulseFilter.frequency.value=140;const sub=this.ctx.createOscillator(),subGain=this.ctx.createGain();sub.type='sine';sub.frequency.value=46.25;subGain.gain.value=.018;sub.connect(subGain);subGain.connect(this.music);pulse.connect(pulseGain);pulseGain.connect(this.musicFilter.frequency);pulse.start();sub.start();this.v10Pulse={pulse,pulseGain,sub,subGain};};
const v10AudioUpdateBase=audio.update.bind(audio);
audio.update=function(g){v10AudioUpdateBase(g);if(!this.ctx)return;const intensity=Math.min(1,(g.wave-1)/10+(g.combo>10?.18:0)+(g.boss?.34:0)+(g.overdriveTime>0?.32:0));this.music.gain.setTargetAtTime(save.music/100*(.34+intensity*.1),this.ctx.currentTime,.1);this.sfxGain.gain.setTargetAtTime(save.sfx/100*.62,this.ctx.currentTime,.1);if(this.v10Pulse){this.v10Pulse.sub.frequency.setTargetAtTime(v9WorldRoots[g.world%v9WorldRoots.length]*.5,this.ctx.currentTime,.4);this.v10Pulse.subGain.gain.setTargetAtTime((.012+intensity*.018)*(save.music/100),this.ctx.currentTime,.3);this.v10Pulse.pulse.frequency.setTargetAtTime(1.6+intensity*2.2,this.ctx.currentTime,.3);this.v10Pulse.pulseGain.gain.setTargetAtTime(80+intensity*220,this.ctx.currentTime,.3);}};
function v10ApplyVolumes(){audio.start();if(!audio.ctx)return;audio.music.gain.setTargetAtTime(save.music/100*.42,audio.ctx.currentTime,.04);audio.sfxGain.gain.setTargetAtTime(save.sfx/100*.62,audio.ctx.currentTime,.04);}
