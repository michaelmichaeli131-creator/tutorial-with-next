/* V28 SCORE — a self-contained adaptive soundtrack.

   What was there: the main music was an mp3 hotlinked from a third-party site, with the procedural
   Web Audio layer mixed underneath it at 17% as a bed. That is two problems in one. The game's
   soundtrack was an external download that could be blocked, rate-limited, or simply gone — and
   when it failed, which it does from behind any restrictive network, all that remained was a
   background layer never meant to carry a track on its own. Thin and unfinished is exactly how it
   would sound.

   A licensed track could not be fetched and self-hosted from this environment either, so rather
   than pretend otherwise the score is now generated, properly, and mixed as the main event.

   What makes this sound like a modern game rather than a chiptune: a real kit instead of beeps,
   detuned saw stacks instead of bare oscillators, a four-bar minor progression that resolves, and
   sidechain ducking — the pump on every kick that is the signature of the genre and the single
   biggest difference between "synth notes" and "a track". It is adaptive as well: the arrangement
   adds and removes layers with the pressure of the run, so a calm wave and a boss fight are the
   same piece of music played at different intensities. */

const V28={
 bpm:126,
 /* i - VI - III - VII in a natural minor: the progression most modern action scores lean on
    because it lifts without ever resolving to major. */
 progression:[0,8,3,10],
 /* Semitone offsets from the root for the chord voiced over each degree. */
 chord:[0,7,12,15],
 duck:.34   /* how far the kick pulls the music down; the pump lives here */
};

let v28Step=0;
let v28NextAt=0;
let v28Bus=null;
let v28Sub=null;

/* One shared voice builder. Two saws detuned against each other, through a lowpass that opens with
   intensity, is the whole timbre — a single oscillator is what makes generated music sound cheap. */
function v28Saw(freq,when,dur,gain,cutoff,target,pan=0,detune=9){
 const ctx=audio.ctx;
 if(!ctx)return;
 const t=ctx.currentTime+when;
 const mix=ctx.createGain();
 const filter=ctx.createBiquadFilter();
 filter.type='lowpass';
 filter.frequency.setValueAtTime(Math.max(120,cutoff),t);
 filter.frequency.exponentialRampToValueAtTime(Math.max(110,cutoff*.45),t+dur);
 filter.Q.value=6;
 mix.gain.setValueAtTime(.0001,t);
 mix.gain.exponentialRampToValueAtTime(Math.max(.0002,gain),t+.012);
 mix.gain.exponentialRampToValueAtTime(.0001,t+dur);
 for(const cents of [-detune,detune]){
  const osc=ctx.createOscillator();
  osc.type='sawtooth';
  osc.frequency.setValueAtTime(freq,t);
  osc.detune.setValueAtTime(cents,t);
  osc.connect(filter);
  osc.start(t);
  osc.stop(t+dur+.05);
 }
 filter.connect(mix);
 if(ctx.createStereoPanner){
  const panner=ctx.createStereoPanner();
  panner.pan.value=Math.max(-1,Math.min(1,pan));
  mix.connect(panner);
  panner.connect(target);
 }else mix.connect(target);
}

/* Sub is a separate voice from the bass line on purpose: one sine an octave down carries the low
   end on a phone speaker that cannot reproduce it, because the harmonics still read as weight. */
function v28SubNote(freq,when,dur,gain){
 const ctx=audio.ctx;
 if(!ctx||!v28Sub)return;
 const t=ctx.currentTime+when;
 const osc=ctx.createOscillator();
 const env=ctx.createGain();
 osc.type='sine';
 osc.frequency.setValueAtTime(freq,t);
 env.gain.setValueAtTime(.0001,t);
 env.gain.exponentialRampToValueAtTime(gain,t+.02);
 env.gain.exponentialRampToValueAtTime(.0001,t+dur);
 osc.connect(env);
 env.connect(v28Sub);
 osc.start(t);
 osc.stop(t+dur+.05);
}

function v28Kick(when,gain){
 const ctx=audio.ctx;
 if(!ctx)return;
 const t=ctx.currentTime+when;
 const osc=ctx.createOscillator();
 const env=ctx.createGain();
 osc.type='sine';
 /* A pitch sweep from 150Hz down to 46Hz is what makes a sine read as a kick drum rather than a
    low note. */
 osc.frequency.setValueAtTime(150,t);
 osc.frequency.exponentialRampToValueAtTime(46,t+.09);
 env.gain.setValueAtTime(.0001,t);
 env.gain.exponentialRampToValueAtTime(gain,t+.005);
 env.gain.exponentialRampToValueAtTime(.0001,t+.26);
 osc.connect(env);
 env.connect(audio.music);
 osc.start(t);
 osc.stop(t+.3);
 /* Sidechain: pull the whole musical bus down and let it breathe back in. This is the pump. */
 if(v28Bus){
  const level=v28Bus.gain;
  const at=ctx.currentTime+when;
  level.cancelScheduledValues(at);
  level.setValueAtTime(1-V28.duck,at);
  level.linearRampToValueAtTime(1,at+.19);
 }
}

function v28Noise(when,dur,gain,cut,q,pan){
 const ctx=audio.ctx;
 if(!ctx)return;
 const t=ctx.currentTime+when;
 const length=Math.max(1,Math.floor(ctx.sampleRate*dur));
 const buffer=ctx.createBuffer(1,length,ctx.sampleRate);
 const data=buffer.getChannelData(0);
 for(let i=0;i<length;i++)data[i]=(Math.random()*2-1)*Math.pow(1-i/length,2.1);
 const source=ctx.createBufferSource();
 const filter=ctx.createBiquadFilter();
 const env=ctx.createGain();
 filter.type='bandpass';
 filter.frequency.value=cut;
 filter.Q.value=q;
 source.buffer=buffer;
 env.gain.setValueAtTime(gain,t);
 env.gain.exponentialRampToValueAtTime(.0001,t+dur);
 source.connect(filter);filter.connect(env);
 if(ctx.createStereoPanner){
  const panner=ctx.createStereoPanner();
  panner.pan.value=pan;
  env.connect(panner);panner.connect(audio.music);
 }else env.connect(audio.music);
 source.start(t);
}

function v28Ensure(){
 if(v28Bus||!audio.ctx)return;
 /* Everything except the kick runs through the ducking bus, so the kick is what does the ducking
    rather than being ducked by itself. */
 v28Bus=audio.ctx.createGain();
 v28Bus.gain.value=1;
 v28Bus.connect(audio.music);
 v28Sub=audio.ctx.createGain();
 v28Sub.gain.value=.9;
 v28Sub.connect(audio.music);
}

/* Replaces the previous step sequencer outright rather than layering on it: two sequencers running
   against each other would be noise, not an arrangement. */
audio.update=function(g){
 if(!this.ctx)return;
 v28Ensure();
 const musicLevel=typeof v12MusicCurve==='function'?v12MusicCurve(save.music):save.music/100;
 const sfxLevel=typeof v12MusicCurve==='function'?v12MusicCurve(save.sfx):save.sfx/100;
 /* Mixed as the main soundtrack now, not as a bed under an external track. */
 this.music.gain.setTargetAtTime(musicLevel*.5,this.ctx.currentTime,.15);
 this.sfxGain.gain.setTargetAtTime(Math.min(1,sfxLevel*.96),this.ctx.currentTime,.06);
 if(!g.running){
  /* The menu keeps the harmony and drops the kit: recognisably the same music, at rest. */
  this.musicFilter.frequency.setTargetAtTime(1500,this.ctx.currentTime,.5);
 }

 const intensity=Math.min(1,
  (g.wave-1)/12
  +(g.combo>10?.12:0)+(g.combo>24?.14:0)
  +(g.boss?.3:0)
  +(g.overdriveTime>0?.26:0)
  +(g.lives<=1&&g.running?.16:0));
 this.musicFilter.frequency.setTargetAtTime(g.running?2400+intensity*7000:1500,this.ctx.currentTime,.25);

 const bpm=V28.bpm+Math.round(intensity*16);
 const sixteenth=60/bpm/4;
 if(this.ctx.currentTime<v28NextAt)return;
 /* Schedule slightly ahead of the clock so a long frame cannot make the beat stutter — the frame
    loop is not a reliable scheduler on its own. */
 const lead=Math.max(0,v28NextAt-this.ctx.currentTime);

 const step=v28Step%16;
 const bar=Math.floor(v28Step/16)%V28.progression.length;
 const world=g.world%v9WorldRoots.length;
 const root=v9WorldRoots[world]*Math.pow(2,V28.progression[bar]/12);
 const playing=g.running;

 if(playing){
  /* Four on the floor. Everything else is arranged around it. */
  if(step%4===0)v28Kick(lead,.5+intensity*.12);
  /* Clap on the backbeat, two layers a hair apart so it has width. */
  if(step===4||step===12){
   v28Noise(lead,.14,.26+intensity*.06,1900,1.1,-.2);
   v28Noise(lead+.012,.11,.2,2600,1.6,.22);
  }
  /* Hats, with the offbeat pushed harder — the shuffle that keeps it moving. */
  if(step%2===1)v28Noise(lead,.035,step%4===3?.1:.055,8200,2.4,(step%8)/8-.4);
  if(intensity>.5&&step%4===2)v28Noise(lead,.028,.05,11000,3,.3);
 }

 /* Sub and bass: syncopated so the groove is not just the kick. */
 if(playing&&[0,3,6,8,11,14].includes(step)){
  v28SubNote(root/4,lead,sixteenth*1.7,.34);
  v28Saw(root/2,lead,sixteenth*1.5,.075+intensity*.03,420+intensity*900,v28Bus,0,7);
 }

 /* Pad: the chord, held across the bar, always present so the menu still has music. */
 if(step===0){
  V28.chord.forEach((semitone,i)=>{
   v28Saw(root*Math.pow(2,semitone/12),lead+i*.012,sixteenth*15,
    (playing?.03:.038)+intensity*.012,900+intensity*2600,v28Bus,(i-1.5)*.28,i===0?5:14);
  });
 }

 /* Lead arpeggio: the layer that arrives with the pressure, so the arrangement grows with the run
    instead of repeating at one level. */
 if(playing&&intensity>.28&&step%2===0){
  const degree=[0,2,1,3,2,1,3,0][(step/2)%8];
  v28Saw(root*Math.pow(2,V28.chord[degree]/12)*2,lead,sixteenth*.85,
   .022+intensity*.03,2600+intensity*4200,v28Bus,((step/2)%4)/3-.5,16);
 }
 if(playing&&g.boss&&step===8)v28SubNote(root/4,lead,sixteenth*3,.3);

 v28Step++;
 v28NextAt=(v28NextAt||this.ctx.currentTime)+sixteenth;
 if(v28NextAt<this.ctx.currentTime)v28NextAt=this.ctx.currentTime+sixteenth;
};

/* The music bed used to sit at 17% because an mp3 was carrying the track. With the score itself
   carrying it, that ceiling has to come off or the setting does nothing. */
if(typeof v12ApplyAudioLevels==='function'){
 v12ApplyAudioLevels=function(){
  const musicLevel=v12MusicCurve(save.music),sfxLevel=v12MusicCurve(save.sfx);
  if(audio.ctx){
   audio.master.gain.setTargetAtTime(1,audio.ctx.currentTime,.03);
   audio.music.gain.setTargetAtTime(musicLevel*.5,audio.ctx.currentTime,.05);
   audio.sfxGain.gain.setTargetAtTime(Math.min(1,sfxLevel*.96),audio.ctx.currentTime,.04);
   audio.compressor.threshold.setTargetAtTime(-10,audio.ctx.currentTime,.08);
  }
 };
}

/* The menu needs music too, and it cannot come from the game loop: `update` returns early when
   nothing is running, so the scheduler would never tick outside a match. A slow ticker drives it
   instead. Calling the scheduler twice in one frame is harmless — it is gated on its own next-beat
   time, not on how often it is asked. */
const v28ShowGame=showGame;
showGame=function(){
 v28ShowGame();
 audio.start();
};
setInterval(()=>{
 if(audio.ctx&&audio.ctx.state==='running'&&(!game.running||game.paused))audio.update(game);
},40);
