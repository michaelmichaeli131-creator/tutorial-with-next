/* V31 LAUNCH SCENE — give the first screen some air and some story.

   Judged from a capture rather than from the code. The launch screen has a strong logo and a
   confident CTA, and the composition is sound. What it lacks is everything between the two: the
   sky is a flat vertical gradient with a scattering of dots, the pilot stands in nothing, and
   there is no hint anywhere of what the game actually is. It reads as a title card for a game
   rather than a moment from one.

   Three additions, all drawn over the existing scene so none of the composition is disturbed:

   1. Light shafts and haze, which is what gives a flat gradient depth. A sky with no atmosphere
      in it always looks like a fill, however nice the colours are.
   2. Hostiles descending in the far distance. Small, slow, and behind the haze — enough to say
      "these are coming and you are the one standing in front of them", which is the entire pitch
      of the game, made without a word of copy.
   3. Embers drifting up through the foreground, so the frame has motion at rest and a sense of
      near and far.

   Cost is not the concern it is in the arena — this loop only runs while the launch screen is up,
   and it stops the moment the player enters. It is still built the cheap way out of habit and to
   keep the first frame fast: the shaft gradient is cached, and the drifting elements are plain
   arithmetic rather than particles. */

const V31={shafts:5, hostiles:7, embers:26};
let v31Grad=null;
let v31GradKey='';

const v31Hostiles=[];
const v31Embers=[];

function v31Seed(){
 if(v31Hostiles.length)return;
 /* Fixed pseudo-random layout rather than Math.random per frame, so the scene is stable and the
    same every time the screen is shown — a title screen that reshuffles itself looks unfinished. */
 for(let i=0;i<V31.hostiles;i++){
  v31Hostiles.push({x:(i*0.173+0.08)%1, depth:.35+((i*0.37)%1)*.5, phase:(i*1.7)%6.28, speed:.012+((i*0.29)%1)*.016});
 }
 for(let i=0;i<V31.embers;i++){
  v31Embers.push({x:(i*0.0917+0.03)%1, y:(i*0.271)%1, depth:.3+((i*0.41)%1)*.7, drift:(i%2?1:-1)*(0.3+((i*0.13)%1))});
 }
}

function v31Shafts(c,w,h,t){
 const key=w+'x'+h;
 if(!v31Grad||v31GradKey!==key){
  v31Grad=c.createLinearGradient(0,0,0,h*.82);
  v31Grad.addColorStop(0,'rgba(150,200,255,.16)');
  v31Grad.addColorStop(.55,'rgba(120,170,255,.05)');
  v31Grad.addColorStop(1,'rgba(90,140,255,0)');
  v31GradKey=key;
 }
 c.save();
 c.globalCompositeOperation='lighter';
 c.fillStyle=v31Grad;
 for(let i=0;i<V31.shafts;i++){
  /* Each shaft breathes on its own slow cycle; shafts that pulse together read as a flicker
     rather than as light moving through dust. */
  const sway=Math.sin(t*.22+i*1.3)*w*.03;
  const top=w*(.12+i*.19)+sway;
  const spread=w*(.08+((i*7)%3)*.03);
  c.globalAlpha=.5+Math.sin(t*.35+i)*.28;
  c.beginPath();
  c.moveTo(top-spread*.22,-10);
  c.lineTo(top+spread*.22,-10);
  c.lineTo(top+spread,h*.82);
  c.lineTo(top-spread,h*.82);
  c.closePath();
  c.fill();
 }
 c.restore();
}

/* Deliberately abstract: a silhouette and a running light, no detail. They are meant to read as a
   threat approaching from far away, and drawing them properly would pull the eye off the pilot. */
function v31DrawHostiles(c,w,h,t){
 c.save();
 for(const hostile of v31Hostiles){
  const y=((t*hostile.speed+hostile.phase*.1)%1);
  const py=h*(.05+y*.42);
  const px=w*hostile.x+Math.sin(t*.4+hostile.phase)*w*.02;
  const size=(6+hostile.depth*10);
  /* First pass had these at a tenth of an alpha and they simply were not there. They have to be
     legible as shapes for the scene to say anything, while staying well under the pilot. */
  c.globalAlpha=.22+hostile.depth*.4;
  c.fillStyle='#8fb6ff';
  c.beginPath();
  c.moveTo(px,py+size);
  c.lineTo(px-size*.8,py-size*.5);
  c.lineTo(px+size*.8,py-size*.5);
  c.closePath();
  c.fill();
  c.globalAlpha=.4+hostile.depth*.5;
  c.fillStyle='#d8ecff';
  c.beginPath();
  c.arc(px,py-size*.1,size*.22,0,Math.PI*2);
  c.fill();
 }
 c.restore();
}

function v31DrawEmbers(c,w,h,t){
 c.save();
 c.globalCompositeOperation='lighter';
 for(const ember of v31Embers){
  const y=1-((t*.045*ember.depth+ember.y)%1);
  const px=w*ember.x+Math.sin(t*.5*ember.drift+ember.y*9)*w*.035;
  const py=h*(.2+y*.78);
  const size=.7+ember.depth*1.9;
  c.globalAlpha=(.12+ember.depth*.3)*(0.35+Math.sin(t*1.6+ember.y*11)*.3+.35);
  c.fillStyle=ember.depth>.72?'#ffd9a0':'#9fd8ff';
  c.beginPath();
  c.arc(px,py,size,0,Math.PI*2);
  c.fill();
 }
 c.restore();
}

const v31SceneBase=v14DrawLaunchSceneV16;
v14DrawLaunchSceneV16=function(c,w,h,t){
 v31SceneBase(c,w,h,t);
 v31Seed();
 /* Order matters: hostiles are far away so they go under the haze and the shafts, embers are near
    so they go over everything. That ordering is the whole depth cue. */
 v31DrawHostiles(c,w,h,t);
 v31Shafts(c,w,h,t);
 /* A haze band across the middle distance separates the sky from the ground plane, which is what
    the flat gradient was missing. */
 c.save();
 c.globalCompositeOperation='lighter';
 c.globalAlpha=.16;
 const haze=c.createLinearGradient(0,h*.42,0,h*.78);
 haze.addColorStop(0,'rgba(90,130,220,0)');
 haze.addColorStop(.5,'rgba(120,150,235,.5)');
 haze.addColorStop(1,'rgba(60,90,180,0)');
 c.fillStyle=haze;
 c.fillRect(0,h*.42,w,h*.36);
 c.restore();
 v31DrawEmbers(c,w,h,t);
};
