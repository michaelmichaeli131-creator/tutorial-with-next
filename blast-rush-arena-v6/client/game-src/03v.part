/* V19 — mechanical detail pass on the creatures.
   Every species builds its body through v15Carapace, so enriching that one helper lifts all six at
   once and keeps them consistent. Four passes are added over the flat gradient fill: panel seams,
   an emissive vent glowing from inside the shell, a specular streak, and a rim light along the lit
   edge. Deliberately no offscreen buffer here — unlike the pilots there can be fifteen creatures on
   screen, and per-entity compositing at that count is not worth the frame time. */
function v19PanelSeams(c,points,pal){
 let minX=Infinity,maxX=-Infinity,minY=Infinity,maxY=-Infinity;
 for(const [x,y] of points){
  if(x<minX)minX=x;
  if(x>maxX)maxX=x;
  if(y<minY)minY=y;
  if(y>maxY)maxY=y;
 }
 const height=maxY-minY;
 c.save();
 v14Art.poly(c,points);
 c.clip();

 /* Seams: dark line with a light under-edge, which is what makes a plate read as raised. */
 c.lineWidth=1;
 for(let i=1;i<=2;i++){
  const y=minY+height*(i/3);
  c.strokeStyle='rgba(2,5,14,.55)';
  c.beginPath();c.moveTo(minX-4,y);c.lineTo(maxX+4,y);c.stroke();
  c.strokeStyle='rgba(255,255,255,.12)';
  c.beginPath();c.moveTo(minX-4,y+1.2);c.lineTo(maxX+4,y+1.2);c.stroke();
 }

 /* Vent: light escaping from inside the shell. */
 c.globalCompositeOperation='lighter';
 const ventY=minY+height*.62;
 const vent=c.createLinearGradient(0,ventY-3,0,ventY+3);
 vent.addColorStop(0,'transparent');
 vent.addColorStop(.5,pal.glow);
 vent.addColorStop(1,'transparent');
 c.fillStyle=vent;
 c.fillRect(minX,ventY-3,(maxX-minX),6);

 /* Specular: one broad diagonal band, the cheapest convincing cue for a hard curved surface. */
 const spec=c.createLinearGradient(minX,minY,maxX*.5,maxY);
 spec.addColorStop(0,'rgba(255,255,255,.22)');
 spec.addColorStop(.42,'rgba(255,255,255,.05)');
 spec.addColorStop(.75,'transparent');
 c.fillStyle=spec;
 c.fillRect(minX-6,minY-6,(maxX-minX)+12,(maxY-minY)+12);
 c.restore();

 /* Rim: the lit edge, offset up-left toward the key light. */
 c.save();
 c.globalCompositeOperation='lighter';
 c.globalAlpha=.7;
 c.translate(-1,-1.4);
 c.strokeStyle=pal.trim;
 c.lineWidth=1.5;
 v14Art.poly(c,points);
 c.stroke();
 c.restore();
}

/* Reassigns the shared body helper; every creature picks the new passes up automatically. */
v15Carapace=function(c,pal,points,x0,y0,x1,y1){
 const g=c.createLinearGradient(x0,y0,x1,y1);
 g.addColorStop(0,pal.trim);
 g.addColorStop(.16,pal.body);
 g.addColorStop(.55,'#0b1226');
 g.addColorStop(.82,pal.body);
 g.addColorStop(1,'#04060f');
 c.fillStyle=g;
 v14Art.poly(c,points);
 c.fill();
 c.strokeStyle=pal.glow+'99';
 c.lineWidth=1.6;
 c.stroke();
 v19PanelSeams(c,points,pal);
};

/* A few silhouette additions where an archetype needed more menace than plating alone gives. */
const v19Creatures=Object.assign({},v15Creatures);

v15Creatures.armored=function(c,o,pal,t){
 v19Creatures.armored(c,o,pal,t);
 /* Shoulder spikes read as "heavy" at a glance and separate it from the scout at small sizes. */
 c.save();
 c.fillStyle=pal.trim;
 c.globalAlpha=.92;
 for(const side of [-1,1]){
  v14Art.poly(c,[[side*20,-20],[side*33,-36],[side*25,-14]]);
  c.fill();
 }
 c.restore();
};

v15Creatures.splitter=function(c,o,pal,t){
 v19Creatures.splitter(c,o,pal,t);
 /* Horns on each head, angled outward so the two-headed silhouette is unmistakable. */
 const sway=Math.sin(t*3+(o.anim||0))*3;
 c.save();
 c.fillStyle=pal.trim;
 for(const side of [-1,1]){
  c.save();
  c.translate(side*10,-20+sway*side*.2);
  v14Art.poly(c,[[side*4,-12],[side*13,-26],[side*9,-8]]);
  c.fill();
  c.restore();
 }
 c.restore();
};

v15Creatures.normal=function(c,o,pal,t){
 v19Creatures.normal(c,o,pal,t);
 /* Dorsal fin: gives the scout a direction of travel even when it is weaving. */
 c.save();
 c.globalCompositeOperation='lighter';
 c.globalAlpha=.75;
 c.fillStyle=pal.glow;
 v14Art.poly(c,[[0,-30],[3,-42],[-3,-42]]);
 c.fill();
 c.restore();
};
