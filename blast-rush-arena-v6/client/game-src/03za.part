/* V22 PRIORITY — make it matter which one you let through.

   V21 gave a price for tapping badly. This is the other half: until now every hostile that
   reached the reactor cost exactly one life, whatever it was. One line handled all of them —
   splice the orb, call damage() — so a bomb, a splitter and a shard runner were worth precisely
   the same to stop. With no difference between targets there was no priority to get right, and
   "tap whatever is lowest" was not merely a good strategy, it was the optimal one. That is the
   shape of a game with nothing to decide.

   Landing consequences now differ by what landed, which gives the field a top and a bottom:

     Bomb        — costs a life and slams the reactor to full heat, so it is the one that must
                   not get through.
     Shard runner— costs no life at all. It escapes with part of the run's haul, so it is the one
                   you are allowed to give up when the field is crowded.
     Everything else — one life, as before.

   The shard runner is the important one. A threat you may deliberately ignore is what turns a
   crowded field from a reaction test into a choice, and it is the first time in this game that
   letting something reach the reactor can be the correct play.

   Applies in duels too. These are rules about what a hostile does, identical on both clients and
   needing no synchronisation — unlike V21's wards and divers, which change what is on the field
   and would disturb the schedule V20 made authoritative. */

const V22_STEAL=6;      /* shards a runner leaves with, capped at what this run has earned */
const V22_ESCAPE_PENALTY=140;

function v22Line(){return H-(isMobile?105:72);}

/* Intercepting a frame early, before the base loop can splice the orb and charge a life for it.
   The band is the furthest an orb can travel in one step — base scales dt by the gravity hazard
   and by slow-motion, and 1.5x covers the larger of the two, so nothing crosses unseen. Catching
   one an imperceptible frame sooner is the acceptable side of that trade. */
function v22Intercept(dt){
 const line=v22Line();
 for(let i=game.orbs.length-1;i>=0;i--){
  const o=game.orbs[i];
  if(o.y+o.speed*dt*1.5<line)continue;
  game.orbs.splice(i,1);
  v22Landed(o);
 }
}

function v22Landed(o){
 if(o.type==='shard')return v22Escape(o);
 damage();
 if(o.type==='bomb')v22Detonate(o);
}

/* A runner does not hit the reactor, it leaves — with up to six of the shards this run earned
   and a slice of score. It can never touch the shards banked from previous runs: a threat that
   eats a player's permanent wallet is a punishment, not a decision. */
function v22Escape(o){
 const steal=Math.min(V22_STEAL,Math.max(0,game.shardsEarned||0));
 if(steal>0){
  game.shardsEarned-=steal;
  save.shards=Math.max(0,save.shards-steal);
  persist();
 }
 game.score=Math.max(0,game.score-V22_ESCAPE_PENALTY);
 floating(o.x,v22Line()-30,steal>0?`ESCAPED −${steal}◈`:'ESCAPED','#7dffb0');
 toast(steal>0?`RUNNER ESCAPED • −${steal} SHARDS`:'RUNNER ESCAPED');
 audio.sfx('warning');
 ring(o.x,v22Line()-20,'#7dffb0',22);
}

/* A bomb reaching the reactor takes the life and the next second of firing with it. Pairing the
   hit with a forced vent is what makes it the target you drop everything for: the cost is not
   one life, it is one life and the window in which you would have recovered. */
function v22Detonate(o){
 game.v21Heat=V21_HEAT.max;
 game.v21Lock=Math.max(game.v21Lock||0,V21_HEAT.lockout);
 explode(o.x,v22Line()-10,'#ff4264',48,1.3);
 toast('BOMB BREACH • REACTOR VENTING');
 haptic([30,40,30]);
}

const v22UpdateBase=update;
update=function(dt){
 if(game.running&&!game.paused)v22Intercept(dt);
 v22UpdateBase(dt);
};

/* Runners are drawn with an escape route so their role is legible before one gets through: the
   player has to be able to see that this is the one they are allowed to lose. */
v19OrbOverlays.push((o)=>{
 if(o.type!=='shard')return;
 const line=v22Line();
 if(o.y>line-40)return;
 ctx.save();
 ctx.globalAlpha=.16+Math.sin(game.elapsed*3+o.x)*.06;
 ctx.strokeStyle='#7dffb0';
 ctx.lineWidth=1.4;
 ctx.setLineDash([3,7]);
 ctx.beginPath();
 ctx.moveTo(o.x,o.y+o.r+4);
 ctx.lineTo(o.x,line-14);
 ctx.stroke();
 ctx.restore();
});
