/* V15.1 — pilot rendering upgrade and per-species enemy behaviour.
   The pilots were drawn as flat filled shapes; they now go through an offscreen buffer that adds a
   rim light, a volumetric top-down light pass and a contact shadow. Compositing per pixel needs an
   isolated surface — applying `source-atop` straight onto the game canvas would tint the whole
   screen, since everything already painted is opaque. */
/* The buffer is V15_BUFFER device px square at 2x density, so it covers +/-V15_HALF logical units
   around the character's origin — wide enough for Omega's wings and the Reaper's scythe. */
const V15_BUFFER=360;
const V15_HALF=V15_BUFFER/4;
const v15Shape=document.createElement('canvas');
const v15Out=document.createElement('canvas');
const v15ShapeCtx=v15Shape.getContext('2d');
const v15OutCtx=v15Out.getContext('2d');
v15Shape.width=v15Shape.height=V15_BUFFER;
v15Out.width=v15Out.height=V15_BUFFER;

function v15PrepareBuffer(context,canvasEl){
 context.setTransform(1,0,0,1,0,0);
 context.clearRect(0,0,canvasEl.width,canvasEl.height);
 /* 2x density keeps edges crisp once the buffer is scaled up onto the target. */
 context.setTransform(2,0,0,2,V15_BUFFER/2,V15_BUFFER/2);
}

v14DrawCharacter=function(c,characterId,time,options={}){
 const ch=v14Character(characterId);
 const scale=options.scale||1;
 const frame=v14Frames[ch.frame]||v14Frames.knight;

 v15PrepareBuffer(v15ShapeCtx,v15Shape);
 v15ShapeCtx.save();
 v15ShapeCtx.shadowBlur=options.glow??18;
 v15ShapeCtx.shadowColor=ch.c1;
 frame(v15ShapeCtx,ch,time);
 v15ShapeCtx.restore();

 v15PrepareBuffer(v15OutCtx,v15Out);
 /* Rim: the silhouette blown up slightly and flooded with the accent, sitting behind the art. */
 v15OutCtx.save();
 v15OutCtx.setTransform(1,0,0,1,0,0);
 v15OutCtx.globalAlpha=.52;
 const spread=2;
 v15OutCtx.drawImage(v15Shape,-spread,-spread,v15Shape.width+spread*2,v15Shape.height+spread*2);
 v15OutCtx.globalCompositeOperation='source-in';
 v15OutCtx.fillStyle=ch.c1;
 v15OutCtx.fillRect(0,0,v15Out.width,v15Out.height);
 v15OutCtx.globalCompositeOperation='source-over';
 v15OutCtx.globalAlpha=1;
 v15OutCtx.drawImage(v15Shape,0,0);
 v15OutCtx.restore();

 /* Volumetric light: bright along the top, shaded toward the feet, plus an upper-left specular. */
 v15OutCtx.save();
 v15OutCtx.globalCompositeOperation='source-atop';
 const light=v15OutCtx.createLinearGradient(0,-V15_HALF*.72,0,V15_HALF*.8);
 light.addColorStop(0,'rgba(255,255,255,.17)');
 light.addColorStop(.38,'rgba(255,255,255,.02)');
 light.addColorStop(.66,'rgba(4,10,28,.2)');
 light.addColorStop(1,'rgba(2,5,18,.52)');
 v15OutCtx.fillStyle=light;
 v15OutCtx.fillRect(-V15_HALF,-V15_HALF,V15_HALF*2,V15_HALF*2);
 const spec=v15OutCtx.createRadialGradient(-30,-48,2,-30,-48,72);
 spec.addColorStop(0,'rgba(255,255,255,.17)');
 spec.addColorStop(1,'rgba(255,255,255,0)');
 v15OutCtx.fillStyle=spec;
 v15OutCtx.fillRect(-V15_HALF,-V15_HALF,V15_HALF*2,V15_HALF*2);
 v15OutCtx.restore();

 c.save();
 c.translate(options.x||0,options.y||0);

 if(options.aura!==false){
  c.save();
  c.globalCompositeOperation='lighter';
  const radius=(options.auraRadius||86)*scale;
  const aura=c.createRadialGradient(0,0,4,0,0,radius);
  aura.addColorStop(0,'#ffffff');
  aura.addColorStop(.16,ch.c1+'cc');
  aura.addColorStop(.52,ch.c2+'55');
  aura.addColorStop(1,'transparent');
  c.globalAlpha=options.auraAlpha??.85;
  c.fillStyle=aura;
  c.beginPath();c.arc(0,0,radius,0,Math.PI*2);c.fill();
  c.restore();
 }

 /* Contact shadow keeps the pilot planted rather than floating. */
 c.save();
 c.globalAlpha=.42;
 const contact=c.createRadialGradient(0,52*scale,0,0,52*scale,50*scale);
 contact.addColorStop(0,'rgba(1,3,10,.85)');
 contact.addColorStop(1,'rgba(1,3,10,0)');
 c.fillStyle=contact;
 c.beginPath();c.ellipse(0,52*scale,48*scale,12*scale,0,0,Math.PI*2);c.fill();
 c.restore();

 c.drawImage(v15Out,-V15_HALF*scale,-V15_HALF*scale,V15_HALF*2*scale,V15_HALF*2*scale);
 c.restore();
};

/* ---------- Per-species behaviour ----------
   Every creature used to fall in the same straight line with the same gentle wobble, so target
   priority was purely about position. Each species now moves in a way you can recognise and plan
   against, which is what makes choosing a weapon matter. */
const v15BehaviourBase=update;
update=function(dt){
 v15BehaviourBase(dt);
 if(!game.running||game.paused)return;
 const margin=26;
 for(const o of game.orbs){
  o.v15T=(o.v15T||0)+dt;
  switch(o.type){
   case 'armored':{
    /* Iron Sentinel braces periodically — a window to focus something else down first. */
    const cycle=o.v15T%3.6;
    o.v15Brace=cycle<.8;
    if(o.v15Brace)o.y-=o.speed*dt*.68;
    break;
   }
   case 'bomb':
    /* Nova Raider commits to a dive: slow to start, dangerous if ignored. */
    o.y+=o.speed*dt*Math.min(1.15,o.v15T*.24);
    break;
   case 'shard':{
    /* Crystal Wraith drifts and blinks sideways, punishing lazy aim. */
    o.x+=Math.cos(o.v15T*1.5+(o.anim||0))*74*dt;
    if(o.v15T>(o.v15Blink||2.4)){
     o.v15Blink=o.v15T+2.4+rng()*2.2;
     ring(o.x,o.y,'#69ffb5',20);
     o.x+=(rng()-.5)*130;
    }
    break;
   }
   case 'splitter':
    /* Twin Beast tracks in hard zigzags. */
    o.x+=Math.sign(Math.sin(o.v15T*1.15))*58*dt;
    break;
   case 'rival':
    /* A rival's core hunts the reactor instead of drifting past it. */
    o.x+=Math.sign(W/2-o.x)*Math.min(46,Math.abs(W/2-o.x))*dt*1.5;
    break;
   default:
    /* Void Scouts weave wide enough to slip past a lazy tap. */
    o.x+=Math.sin(o.v15T*2.3+(o.anim||0))*52*dt;
  }
  o.x=Math.max(margin,Math.min(W-margin,o.x));
 }
};

/* Bracing sentinels flash their shield so the pause is readable rather than feeling like lag. */
const v15BraceDrawBase=drawOrb;
drawOrb=function(o,w){
 v15BraceDrawBase(o,w);
 if(o.type!=='armored'||!o.v15Brace)return;
 ctx.save();
 ctx.globalCompositeOperation='lighter';
 ctx.globalAlpha=.35+.25*Math.sin(game.elapsed*12);
 ctx.strokeStyle='#9fd8ff';
 ctx.lineWidth=2.5;
 ctx.beginPath();ctx.arc(o.x,o.y,o.r*1.5,0,Math.PI*2);ctx.stroke();
 ctx.restore();
};
