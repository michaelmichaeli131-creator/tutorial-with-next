const v9EnemyNames={normal:'VOID SCOUT',armored:'IRON SENTINEL',bomb:'NOVA RAIDER',shard:'CRYSTAL WRAITH',splitter:'TWIN BEAST',rival:'RIVAL WARLORD'};
