function v9DrawScout(o,color){const flap=Math.sin(o.phase*2.3+o.variant)*8,blink=Math.sin(o.phase*.55)>-.92?1:.12;ctx.fillStyle=color+'44';v9Poly([[-13,-4],[-38,-20-flap],[-30,7],[-15,14]]);ctx.fill();v9Poly([[13,-4],[38,-20+flap],[30,7],[15,14]]);ctx.fill();v9Limb(-12,18,-20,34,5,color);v9Limb(12,18,20,34,5,color);ctx.fillStyle=v9Metal(color);v9RoundPath(-18,-19,36,45,13);ctx.fill();ctx.strokeStyle=color;ctx.lineWidth=2;ctx.stroke();ctx.fillStyle='#0b1525';v9RoundPath(-15,-27,30,19,8);ctx.fill();v9Visor(21,color,blink);ctx.fillStyle=color;v9Poly([[-7,26],[0,38],[7,26]]);ctx.fill();}
