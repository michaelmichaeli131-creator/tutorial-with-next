function v9RoundPath(x,y,w,h,r){const q=Math.min(r,Math.abs(w)/2,Math.abs(h)/2);ctx.beginPath();ctx.moveTo(x+q,y);ctx.lineTo(x+w-q,y);ctx.quadraticCurveTo(x+w,y,x+w,y+q);ctx.lineTo(x+w,y+h-q);ctx.quadraticCurveTo(x+w,y+h,x+w-q,y+h);ctx.lineTo(x+q,y+h);ctx.quadraticCurveTo(x,y+h,x,y+h-q);ctx.lineTo(x,y+q);ctx.quadraticCurveTo(x,y,x+q,y);ctx.closePath();}
function v9Poly(points){ctx.beginPath();ctx.moveTo(points[0][0],points[0][1]);for(let i=1;i<points.length;i++)ctx.lineTo(points[i][0],points[i][1]);ctx.closePath();}
function v9Metal(color,dark='#07101f'){const g=ctx.createLinearGradient(-24,-28,24,30);g.addColorStop(0,'#f7ffff');g.addColorStop(.12,color);g.addColorStop(.5,dark);g.addColorStop(.78,color);g.addColorStop(1,'#02040a');return g;}
