const v9SpawnBase=spawnOrb;
spawnOrb=function(type){v9SpawnBase(type);const o=game.orbs.at(-1);if(o){o.variant=Math.floor(rng()*4);o.anim=rng()*Math.PI*2;o.label=v9EnemyNames[o.type]||'HOSTILE';}};
const v9SpawnRivalBase=spawnRival;
spawnRival=function(core){v9SpawnRivalBase(core);const o=game.orbs.at(-1);if(o){o.variant=9;o.label='RIVAL WARLORD';}};
drawOrb=function(o,w){const color=o.type==='bomb'?'#ff3f61':o.type==='shard'?'#69ffb5':o.type==='armored'?'#61a5ff':o.type==='rival'?currentSkin(o.skin).c1:o.type==='splitter'?'#ffe05f':w.enemy;const scale=o.r/30,bob=Math.sin(o.phase*1.3+(o.anim||0))*3;ctx.save();ctx.translate(o.x,o.y+bob);ctx.scale(scale,scale);ctx.shadowBlur=quality.glow;ctx.shadowColor=color;ctx.globalCompositeOperation='lighter';ctx.fillStyle=color+'16';ctx.beginPath();ctx.ellipse(0,8,46,38,0,0,Math.PI*2);ctx.fill();ctx.globalCompositeOperation='source-over';if(o.type==='armored')v9DrawHeavy(o,color);else if(o.type==='bomb')v9DrawBomb(o,color);else if(o.type==='shard')v9DrawWraith(o,color);else if(o.type==='splitter')v9DrawSplitter(o,color);else if(o.type==='rival')v9DrawRival(o,color);else v9DrawScout(o,color);v9Health(o,color);ctx.restore();};
function v9WorldScenery(w){const idx=game.world%worlds.length,t=game.elapsed;ctx.save();ctx.globalAlpha=.24;ctx.fillStyle=w.accent;ctx.strokeStyle=w.accent;ctx.lineWidth=2;if(idx===0){for(let i=0;i<8;i++){const x=i*W/7+(i%2)*18,h=45+(i%4)*22;ctx.fillRect(x-12,H-h,24,h);ctx.fillRect(x-21,H-h+12,42,7);ctx.beginPath();ctx.arc(x,H-h,8,Math.PI,0);ctx.stroke();}}else if(idx===1){for(let i=0;i<9;i++){const x=i*W/8,h=45+(i%5)*24;v9Poly([[x-25,H],[x,H-h],[x+20,H]]);ctx.fill();}}else if(idx===2){ctx.beginPath();ctx.arc(W*.78,H*.22,58+Math.sin(t)*4,0,Math.PI*2);ctx.fill();for(let i=0;i<6;i++){const x=i*W/5;ctx.fillRect(x-8,H-90-(i%2)*20,16,90+(i%2)*20);ctx.fillRect(x-21,H-92-(i%2)*20,42,8);}}else if(idx===3){for(let i=0;i<5;i++){const x=i*W/4;ctx.beginPath();ctx.moveTo(x-42,H);ctx.lineTo(x-42,H-80);ctx.quadraticCurveTo(x,H-145,x+42,H-80);ctx.lineTo(x+42,H);ctx.stroke();}}else if(idx===4){for(let i=0;i<7;i++){const x=i*W/6;ctx.lineWidth=5;ctx.beginPath();ctx.moveTo(x,H);ctx.quadraticCurveTo(x+35*Math.sin(t*.3+i),H-80,x-10,H-145);ctx.stroke();ctx.beginPath();ctx.arc(x-8,H-150,18+(i%3)*7,0,Math.PI*2);ctx.fill();}}else{ctx.beginPath();ctx.arc(W*.5,H*.58,Math.min(W,H)*.34,0,Math.PI*2);ctx.stroke();ctx.setLineDash([22,18]);ctx.lineWidth=4;ctx.beginPath();ctx.arc(W*.5,H*.58,Math.min(W,H)*.25+t%20,0,Math.PI*2);ctx.stroke();}ctx.restore();}
drawBackground=function(w){const t=game.elapsed;ctx.save();const neb=ctx.createRadialGradient(W*.16+Math.sin(t*.08)*W*.12,H*.22,0,W*.22,H*.3,Math.max(W,H)*.78);neb.addColorStop(0,w.accent+'32');neb.addColorStop(.42,w.enemy+'1a');neb.addColorStop(1,'transparent');ctx.fillStyle=neb;ctx.fillRect(0,0,W,H);const planet=ctx.createRadialGradient(W*.82-20,H*.19-24,4,W*.82,H*.19,isMobile?70:110);planet.addColorStop(0,'#ffffffaa');planet.addColorStop(.12,w.accent+'cc');planet.addColorStop(.55,w.enemy+'66');planet.addColorStop(1,'transparent');ctx.fillStyle=planet;ctx.beginPath();ctx.arc(W*.82,H*.19,isMobile?70:110,0,Math.PI*2);ctx.fill();ctx.globalCompositeOperation='lighter';for(let i=0;i<quality.stars;i++){const depth=1+i%3,x=(i*137+t*(5+depth*8))%W,y=(i*79+(i%7)*23)%H,r=.5+depth*.45,tw=.35+.65*Math.sin(t*(.8+depth*.22)+i);ctx.globalAlpha=.18+tw*.56;ctx.fillStyle=i%10===0?w.accent:'#fff';ctx.fillRect(x,y,r*(game.overdriveTime>0?3:1),r);}if(game.overdriveTime>0&&!reduceMotion){ctx.globalAlpha=.22;ctx.strokeStyle=w.accent;for(let i=0;i<18;i++){const y=(i*67+t*190)%H;ctx.beginPath();ctx.moveTo((i*113)%W,y);ctx.lineTo(((i*113)%W)+40,y+110);ctx.stroke();}}ctx.globalCompositeOperation='source-over';ctx.globalAlpha=1;v9WorldScenery(w);ctx.restore();};
drawReactor=function(){const s=currentSkin(),x=W/2,y=H-(isMobile?104:67),walk=Math.sin(game.elapsed*4)*3;ctx.save();ctx.translate(x,y);ctx.shadowBlur=quality.glow*1.35;ctx.shadowColor=s.c1;ctx.globalCompositeOperation='lighter';const aura=ctx.createRadialGradient(0,0,2,0,0,isMobile?72:84);aura.addColorStop(0,'#fff');aura.addColorStop(.15,s.c1+'dd');aura.addColorStop(.5,s.c2+'66');aura.addColorStop(1,'transparent');ctx.fillStyle=aura;ctx.beginPath();ctx.arc(0,0,isMobile?72:84,0,Math.PI*2);ctx.fill();ctx.globalCompositeOperation='source-over';v9Limb(-15,18,-22,38+walk,8,s.c1);v9Limb(15,18,22,38-walk,8,s.c1);v9Limb(-19,-2,-34,16-walk,7,s.c1);v9Limb(19,-2,34,16+walk,7,s.c1);ctx.fillStyle=v9Metal(s.c1,s.c2);v9Poly([[0,-35],[22,-20],[20,20],[10,33],[-10,33],[-20,20],[-22,-20]]);ctx.fill();ctx.strokeStyle='#ffffff88';ctx.lineWidth=2;ctx.stroke();ctx.fillStyle='#040812';v9RoundPath(-15,-31,30,18,7);ctx.fill();v9Visor(21,s.c1,1);ctx.fillStyle='#fff';ctx.shadowBlur=18;ctx.shadowColor=s.c1;ctx.beginPath();ctx.arc(0,7,7,0,Math.PI*2);ctx.fill();ctx.shadowBlur=0;for(const side of [-1,1]){const flame=14+Math.sin(game.elapsed*12+side)*5;const fg=ctx.createLinearGradient(side*12,27,side*12,27+flame);fg.addColorStop(0,'#fff');fg.addColorStop(.3,s.c1);fg.addColorStop(1,'transparent');ctx.fillStyle=fg;v9Poly([[side*7,26],[side*16,26],[side*12,27+flame]]);ctx.fill();}ctx.restore();};
drawProjectile=function(p){const a=Math.atan2(p.vy,p.vx);ctx.save();ctx.translate(p.x,p.y);ctx.rotate(a+Math.PI/2);ctx.globalCompositeOperation='lighter';ctx.shadowBlur=26;ctx.shadowColor=p.color;const tail=ctx.createLinearGradient(0,-p.r*3,0,p.r);tail.addColorStop(0,'transparent');tail.addColorStop(.5,p.color+'88');tail.addColorStop(1,'#fff');ctx.fillStyle=tail;v9Poly([[0,-p.r*3],[-p.r*.65,p.r*.4],[0,p.r],[p.r*.65,p.r*.4]]);ctx.fill();ctx.strokeStyle='#fff';ctx.lineWidth=1.5;ctx.beginPath();ctx.moveTo(0,-p.r*.3);ctx.lineTo(0,p.r);ctx.stroke();ctx.restore();};
drawBoss=function(b,w){const r=b.r,t=b.t,phase=b.phase,arm=Math.sin(t*1.7)*r*.1;ctx.save();ctx.translate(b.x,b.y);ctx.shadowBlur=quality.glow*2;ctx.shadowColor=w.accent;ctx.globalCompositeOperation='lighter';for(let i=0;i<3;i++){ctx.save();ctx.rotate(t*(i%2?-.14:.11)+i);ctx.strokeStyle=i===1?w.enemy:w.accent;ctx.lineWidth=5-i;ctx.setLineDash([r*.2,r*.09]);ctx.beginPath();ctx.arc(0,0,r*(1.18-i*.17),0,Math.PI*2);ctx.stroke();ctx.restore();}ctx.globalCompositeOperation='source-over';ctx.fillStyle=w.enemy+'55';v9Poly([[-r*.38,-r*.25],[-r*1.18,-r*.78-arm],[-r*.92,r*.2],[-r*.38,r*.48]]);ctx.fill();v9Poly([[r*.38,-r*.25],[r*1.18,-r*.78+arm],[r*.92,r*.2],[r*.38,r*.48]]);ctx.fill();v9Limb(-r*.45,-r*.05,-r*.88,r*.25+arm,r*.16,w.accent);v9Limb(r*.45,-r*.05,r*.88,r*.25-arm,r*.16,w.accent);v9Limb(-r*.22,r*.48,-r*.34,r*.88,r*.18,w.accent);v9Limb(r*.22,r*.48,r*.34,r*.88,r*.18,w.accent);const body=ctx.createLinearGradient(-r*.5,-r*.6,r*.5,r*.65);body.addColorStop(0,'#fff');body.addColorStop(.12,w.accent);body.addColorStop(.52,'#100b2b');body.addColorStop(.82,w.enemy);body.addColorStop(1,'#02030a');ctx.fillStyle=body;v9Poly([[0,-r*.72],[r*.48,-r*.4],[r*.42,r*.43],[r*.18,r*.68],[-r*.18,r*.68],[-r*.42,r*.43],[-r*.48,-r*.4]]);ctx.fill();ctx.strokeStyle='#ffffff66';ctx.lineWidth=2;ctx.stroke();ctx.fillStyle='#02040b';v9RoundPath(-r*.28,-r*.66,r*.56,r*.26,r*.08);ctx.fill();v9Visor(r*.38,phase===3?'#ff486c':w.accent,1);ctx.fillStyle='#fff';ctx.shadowBlur=30;ctx.shadowColor=w.accent;ctx.beginPath();ctx.arc(0,r*.05,r*.1,0,Math.PI*2);ctx.fill();ctx.shadowBlur=0;ctx.fillStyle=w.enemy;for(const side of [-1,1]){ctx.save();ctx.translate(side*r*.5,-r*.32);ctx.rotate(side*(.15+arm/r*.4));v9Poly([[0,-r*.18],[side*r*.3,-r*.05],[side*r*.23,r*.16],[0,r*.12]]);ctx.fill();ctx.restore();}for(const weak of b.weak){if(!weak.alive)continue;const wx=Math.cos(weak.a+t*.6)*(r+36),wy=Math.sin(weak.a+t*.6)*(r*.65+28);ctx.save();ctx.translate(wx,wy);ctx.globalCompositeOperation='lighter';ctx.shadowBlur=32;ctx.sha