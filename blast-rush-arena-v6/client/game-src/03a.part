const v9AudioStart=audio.start.bind(audio);
audio.start=function(){v9AudioStart();if(!this.ctx||this.v9Ambient)return;const pad=this.ctx.createGain(),filter=this.ctx.createBiquadFilter(),lfo=this.ctx.createOscillator(),lfoGain=this.ctx.createGain();pad.gain.value=.014;filter.type='lowpass';filter.frequency.value=900;filter.Q.value=1.8;lfo.frequency.value=.08;lfoGain.gain.value=340;lfo.connect(lfoGain);lfoGain.connect(filter.frequency);const nodes=[.5,1,1.4983].map((ratio,i)=>{const o=this.ctx.createOscillator();o.type=i===0?'sine':'triangle';o.frequency.value=v9WorldRoots[0]*ratio;o.detune.value=(i-1)*7;o.connect(filter);o.start();return o;});filter.connect(pad);pad.connect(this.music);lfo.start();this.v9Ambient={nodes,pad,filter,lfo,lfoGain};};
audio.update=function(g){if(!this.ctx||!g.running)return;this.music.gain.setTargetAtTime(save.music/100*.36,this.ctx.currentTime,.14);this.sfxGain.gain.setTargetAtTime(save.sfx/100*.58,this.ctx.currentTime,.12);const intensity=Math.min(1,(g.wave-1)/11+(g.combo>8?.14:0)+(g.combo>22?.14:0)+(g.boss?.28:0)+(g.overdriveTime>0?.3:0));this.musicFilter.frequency.setTargetAtTime(2100+intensity*7600,this.ctx.currentTime,.18);const world=g.world%worlds.length,base=v9WorldRoots[world],progression=v9Progressions[world],barIndex=Math.floor(this.step/16)%progression.length,root=base*Math.pow(2,progression[barIndex]/12),chord=v9ChordSets[(world+barIndex)%v9ChordSets.length];if(this.v9Ambient){this.v9Ambient.nodes.forEach((o,i)=>o.frequency.setTargetAtTime(root*[.5,1,1.4983][i],this.ctx.currentTime,.45));this.v9Ambient.filter.frequency.setTargetAtTime(720+intensity*1500,this.ctx.currentTime,.4);this.v9Ambient.pad.gain.setTargetAtTime(.012+intensity*.01,this.ctx.currentTime,.35);}if(this.ctx.currentTime<this.nextBeat)return;const bpm=108+world*3+Math.round(intensity*34),sixteenth=60/bpm/4,step=this.step%16,pan=((step%5)-2)/3;if(step===0||step===8)this.kick(0,.13+intensity*.07);if(step===4||step===12)this.noise(.12,.055+intensity*.035,1500,this.music,pan);if(step%2===1)this.noise(.025,.012+intensity*.013,6500,this.music,pan);if([0,3,6,8,11,14].includes(step)){const bassNote=root*.5*(step===14?1.4983:1);this.tone(bassNote,sixteenth*1.6,'sawtooth',.032+intensity*.025,this.music,0,step===14?1.22:.98,pan*.35);}if(step===0||step===8){for(let i=0;i<3;i++)this.tone(root*chord[i],sixteenth*7.2,i===0?'triangle':'sine',.012+intensity*.008,this.music,i*.015,1,(i-1)*.34);}if(step%2===0){const arpIndex=(step/2+barIndex)%3;this.tone(root*chord[arpIndex]*2,sixteenth*.72,'triangle',.018+intensity*.014,this.music,.01,step===14?1.22:1,pan);}if(intensity>.48&&[2,6,10,14].includes(step)){const lead=[2,1,2,0][Math.floor(step/4)]||0;this.tone(root*chord[lead]*4,sixteenth*.9,'square',.008+intensity*.01,this.music,.018,1.08,-pan);}if(g.boss&&step%4===0)this.tone(root*.25,sixteenth*3.2,'sawtooth',.025,this.music,0,.82,0);this.step++;this.nextBeat=this.ctx.currentTime+sixteenth;};
