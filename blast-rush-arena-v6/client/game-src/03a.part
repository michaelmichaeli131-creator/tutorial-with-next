function v9DrawBomb(o,color){const pulse=.8+.2*Math.sin(o.phase*4);ctx.rotate(Math.sin(o.phase*.7)*.18);ctx.fillStyle='#210711';v9Poly([[-25,-5],[-39,-20],[-34,10],[-20,20]]);ctx.fill();v9Poly([[25,-5],[39,-20],[34,10],[20,20]]);ctx.fill();ctx.fillStyle=v9Metal(color,'#260611');v9Poly([[0,-31],[24,-15],[27,16],[10,31],[-10,31],[-27,16],[-24,-15]]);ctx.fill();ctx.strokeStyle=color;ctx.lineWidth=3;ctx.stroke();ctx.fillStyle='#050208';v9RoundPath(-17,-17,34,17,6);ctx.fill();v9Visor(24,'#ffdf69',1);ctx.strokeStyle='#ffdf69';ctx.lineWidth=3;ctx.beginPath();ctx.moveTo(0,-31);ctx.quadraticCurveTo(8,-44,18,-40);ctx.stroke();ctx.fillStyle='#fff3a0';ctx.shadowBlur=24*pulse;ctx.shadowColor='#ff3f61';ctx.beginPath();ctx.arc(19,-40,4+3*pulse,0,Math.PI*2);ctx.fill();ctx.fillStyle='#f8d4df';v9Poly([[-11,8],[0,17],[11,8],[7,24],[-7,24]]);ctx.fill();}
