function explode(x,y,color,count=32,power=1){const n=save.comfort?Math.ceil(count*.35):count;for(let i=0;i<n;i++){const a=rng()*Math.PI*2,s=(70+rng()*420)*power;game.particles.push({x,y,vx:Math.cos(a)*s,vy:Math.sin(a)*s,life:.35+rng()*.8,max:1,r:1+rng()*6,color,drag:.96,gravity:30+rng()*110});}ring(x,y,color,16*power);game.shake=Math.min(save.comfort?4:22,game.shake+5*power);}
function ring(x,y,color,r=18){game.rings.push({x,y,r,life:.55,max:.55,color});}
function floating(x,y,text,color='#fff'){game.texts.push({x,y,text,color,life:.8,max:.8});}
function score(delta,event='hit'){delta=Math.floor(delta*game.scoreMult*(game.overdriveTime>0?2:1));game.score+=delta;if(game.mode==='duel')BlastNetwork.score(delta,event,game.combo,game.wave);floating(W*.5,H*.38,'+'+format(delta),event==='perfect'?'#ffe866':'#8cecff');}
function hitOrb(o,x,y,chain=false){const d=Math.hypot(x-o.x,y-o.y),perfect=d<o.r*game.perfectWindow;o.hp--;explode(o.x,o.y,o.type==='rival'?currentSkin(o.skin).c1:o.type==='bomb'?'#ff4264':'#ff9e35',perfect?42:24,perfect?1.25:1);if(o.hp>0){score(90,'hit');audio.sfx('armor');return;}const index=game.orbs.indexOf(o);if(index>=0)game.orbs.splice(index,1);game.kills++;game.waveKills++;game.combo++;game.maxCombo=Math.max(game.maxCombo,game.combo);game.waveTimer=0;let points=perfect?700:220,event=perfect?'perfect':'hit';if(perfect){game.perfects++;game.overdrive=Math.min(100,game.overdrive+11);audio.sfx('perfect');}else{game.overdrive=Math.min(100,game.overdrive+5);audio.sfx('hit');}game.blast=Math.min(100,game.blast+(perfect?9:5)*game.blastGain);if(o.type==='shard'){game.shardsEarned+=3;save.shards+=3;persist();points+=400;}if(o.type==='rival'){points+=o.bonus;game.shardsEarned+=2+o.tier;save.shards+=2+o.tier;persist();event='rival_core';toast(`RIVAL CORE DEFUSED • +${format(points)}`);audio.sfx('defuse');}if(o.type==='bomb'){event='chain';for(const n of [...game.orbs])if(Math.hypot(n.x-o.x,n.y-o.y)<game.chainRadius)hitOrb(n,n.x,n.y,true);}if(o.type==='splitter'&&!chain){for(let i=0;i<2;i++){spawnOrb('normal');const n=game.orbs.at(-1);n.x=o.x+(i?25:-25);n.y=o.y;}}score(points,event);if(game.mode==='duel'){game.pressure=Math.min(100,game.pressure+(perfect?15:event==='chain'?20:event==='rival_core'?22:5));}checkWave();}
function damage(){if(game.shields>0){game.shields--;toast('PHASE SHIELD SAVED THE REACTOR');audio.sfx('shield');return;}game.lives--;game.combo=0;game.shake=save.comfort?3:18;explode(W/2,H-75,'#ff385b',55,1.4);audio.sfx('damage');if(game.mode==='duel')BlastNetwork.score(-1500,'penalty',0,game.wave);if(game.lives<=0)finish(false);}
function checkWave(){if(game.boss)return;if(game.waveKills>=game.waveTarget){game.objectiveDone=true;score(5000+game.wave*800,'objective');toast('DIRECTIVE COMPLETE');setTimeout(nextWave,750);}}
function nextWave(){if(!game.running)return;game.wave++;game.world=Math.floor((game.wave-1)/4)%worlds.length;game.waveKills=0;game.waveTarget=18+game.wave*2;game.objective=['PURGE','PERFECT HUNT','CHAIN REACTION','NO DAMAGE'][game.wave%4];if(game.wave%4===0)spawnBoss(false);else if(game.wave%3===0)chooseAugment();updateHud();}
function chooseAugment(){game.paused=true;const picks=[...AUGMENTS].sort(()=>rng()-.5).slice(0,3);$('augmentGrid').innerHTML='';for(const a of picks){const b=document.createElement('button');b.className='augment-card';b.innerHTML=`<b>${a.name}</b><p>${a.desc}</p><small>INSTALL</small>`;b.onclick=()=>{a.apply(game);showScreen(null);game.paused=false;toast(`${a.name.toUpperCase()} INSTALLED`);};$('augmentGrid').appendChild(b);}showScreen('augmentScreen');}
function bossClick(x,y){const b=game.boss;if(!b)return false;for(const weak of b.weak){if(!weak.alive)continue;const wx=b.x+Math.cos(weak.a+b.t*.6)*(b.r+36),wy=b.y+Math.sin(weak.a+b.t*.6)*(b.r*.65+28);if(Math.hypot(x-wx,y-wy)<24){weak.hp--;explode(wx,wy,worlds[game.world].accent,32);score(1000,'hit');if(weak.hp<=0){weak.alive=false;score(3500,'perfect');toast('WEAK POINT SHATTERED');}return true;}}
 if(b.weak.some(w=>w.alive))return false;if(Math.hypot(x-b.x,y-b.y)<b.r){b.hp-=game.overdriveTime>0?5:2;explode(x,y,'#ffb347',26);score(420,'hit');if(b.hp/b.maxHp<.67&&b.phase===1){b.phase=2;cinematic('PHASE II • WEAPONS UNBOUND');}if(b.hp/b.maxHp<.33&&b.phase===2){b.phase=3;cinematic('PHASE III • OMEGA RAGE');}if(b.hp<=0)defeatBoss();return true;}return false;}
function defeatBoss(){const b=game.boss;score(30000+game.wave*3500,'boss');for(let i=0;i<12;i++)setTimeout(()=>explode(b.x+(rng()-.5)*b.r*1.5,b.y+(rng()-.5)*b.r,worlds[game.world].accent,45,1.5),i*80);game.boss=null;game.shardsEarned+=20;save.shards+=20;persist();audio.sfx('bossDown');toast('TITAN DESTROYED');if(game.mode==='gauntlet'){game.gauntletIndex++;game.wave++;game.world=game.gauntletIndex%worlds.length;setTimeout(()=>{chooseAugment();setTimeout(()=>spawnBoss(true),900);},1200);}else setTimeout(nextWave,1300);}
function activateOverdrive(){if(game.overdrive<100||!game.running)return;game.overdrive=0;game.overdriveTime=game.overdriveDuration;cinematic('OVERDRIVE');audio.sfx('overdrive');}
function activateBlast(){if(game.blast<100||!game.running)return;game.blast=0;for(const o of [...game.orbs])hitOrb(o,o.x,o.y,true);if(game.boss){game.boss.hp-=18;for(const w of game.boss.weak)if(w.alive)w.hp--;game.boss.weak.forEach(w=>{if(w.hp<=0)w.alive=false;});}explode(W/2,H-70,'#61efff',130,2);score(4000,'blast');audio.sfx('blast');}
function sendPressure(){if(game.mode!=='duel'||game.pressure<100)return;if(BlastNetwork.pressure()){game.pressure=0;toast('PRESSURE ATTACK SENT');audio.sfx('volley');}}
function sendCore(){if(game.mode!=='duel'||game.ammo<1)return;if(BlastNetwork.launchCore()){game.ammo--;toast('RIVAL CORE LAUNCHED');audio.sfx('volley');}}
function applyHazard(kind,duration){toast(`${kind.toUpperCase()} ATTACK INCOMING`);if(kind==='swarm')for(let i=0;i<7;i++)setTimeout(()=>spawnOrb('armored'),i*140);game.hazard={kind,until:performance.now()+duration};audio.sfx('warning');}
function pointer(e){if(!game.running||game.paused)return;const r=canvas.getBoundingClientRect(),x=(e.clientX-r.left)/r.width*W,y=(e.clientY-r.top)/r.height*H;for(const p of [...game.projectiles])if(Math.hypot(x-p.x,y-p.y)<p.r+12){game.projectiles.splice(game.projectiles.indexOf(p),1);score(850,'hit');explode(p.x,p.y,'#ffde58',24);audio.sfx('defuse');return;}if(bossClick(x,y))return;const hits=game.orbs.filter(o=>Math.hypot(x-o.x,y-o.y)<o.r+10).sort((a,b)=>a.r-b.r);if(hits[0])hitOrb(hits[0],x,y);}
canvas.addEventListener('pointerdown',pointer);
function update(dt){if(!game.running||game.paused)return;const slow=game.slow>0?.28:1;dt*=slow;game.elapsed+=dt;game.waveTimer+=dt;if(game.slow>0)game.slow-=dt;if(game.overdriveTime>0)game.overdriveTime-=dt;const hazard=game.hazard&&performance.now()<game.hazard.until?game.hazard:null;game.spawnTimer-=dt;const spawnRate=Math.max(.22,1.05-game.wave*.035)*(hazard?.kind==='gravity'?.65:1);if(!game.boss&&game.spawnTimer<=0){spawnOrb();game.spawnTimer=spawnRate;}
 for(let i=game.orbs.length-1;i>=0;i--){const o=game.orbs[i];o.phase+=dt*4;o.y+=o.speed*dt*(hazard?.kind==='gravity'?1.5:1);o.x+=Math.sin(o.phase)*18*dt;if(o.y>H-72){game.orbs.splice(i,1);damage();}}
 if(game.boss){const b=game.boss;b.t+=dt;b.x=W/2+Math.sin(b.t*.45)*W*.18;b.y=Math.max(130,H*.2)+Math.sin(b.t*.7)*18;const rate=b.phase===1?1.5:b.phase===2?.9:.55;if(rng()<dt/rate){const a=Math.atan2(H-70-b.y,W/2-b.x)+(rng()-.5)*.8;game.projectiles.push({x:b.x,y:b.y,vx:Math.cos(a)*(130+b.phase*35),vy:Math.sin(a)*(130+b.phase*35),r:12+b.phase*2,life:6,color:worlds[game.world].accent});}}
 for(let i=game.projectiles.length-1;i>=0;i--){const p=game.projectiles[i];p.x+=p.vx*dt;p.y+=p.vy*dt;p.life-=dt;if(p.life<0||p.y>H-65){game.projectiles.splice(i,1);damage();}}
 for(let i=game.particles.length-1;i>=0;i--){const p=game.particles[i];p.x+=p.vx*dt;p.y+=p.vy*dt;p.vx*=p.drag;p.vy=p.vy*p.drag+p.gravity*dt;p.life-=dt;if(p.life<=0)game.particles.splice(i,1);}
 for(let i=game.rings.length-1;i>=0;i--){const r=game.rings[i];r.r+=260*dt;r.life-=dt;if(r.life<=0)game.rings.splice(i,1);}
 for(let i=game.texts.length-1;i>=0;i--){const t=game.texts[i];t.y-=42*dt;t.life-=dt;if(t.life<=0)game.texts.splice(i,1);}
 game.shake*=.88;audio.update(game);updateHud();}
