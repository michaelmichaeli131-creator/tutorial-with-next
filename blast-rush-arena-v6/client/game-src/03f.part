/* Weapons are lateral, not a straight power ladder: every one wins in a different situation and
   every special effect is rate limited so no purchase can turn into a fire-rate advantage. */
const v14Weapons=[
 {id:'pulse',name:'PULSE DRIVER',tag:'STARTER',cost:0,upgrade:260,max:5,
  desc:'Dependable single-target driver. Levels add raw punch and titan damage.',
  stats:(l)=>({damage:1+Math.floor(l/2),bossMult:1+l*.28,splash:0,splashHits:0,chain:0,aoe:0,credits:1,cooldown:0})},
 {id:'scatter',name:'SCATTER VOLLEY',tag:'CROWD',cost:900,upgrade:340,max:5,
  desc:'Splits each shot into nearby hostiles. Built for dense swarm stages.',
  stats:(l)=>({damage:1,bossMult:.8+l*.12,splash:78+l*16,splashHits:1+l,chain:0,aoe:0,credits:1,cooldown:.24})},
 {id:'lance',name:'VOID LANCE',tag:'ARMOUR',cost:1500,upgrade:420,max:5,
  desc:'Heavy piercing lance. Shreds armour and titans, slower against swarms.',
  stats:(l)=>({damage:2+Math.floor(l/2),bossMult:1.7+l*.42,splash:0,splashHits:0,chain:0,aoe:0,credits:1,cooldown:.3})},
 {id:'arc',name:'ARC CHAIN',tag:'CHAIN',cost:2100,upgrade:460,max:5,
  desc:'Electric arc that jumps between hostiles and keeps long combos alive.',
  stats:(l)=>({damage:1,bossMult:.9+l*.16,splash:0,splashHits:0,chain:1+l,aoe:0,credits:1,cooldown:.28})},
 {id:'siphon',name:'SHARD SIPHON',tag:'ECONOMY',cost:2400,upgrade:400,max:5,
  desc:'Converts kills into credits. Lower damage, far better stage payouts.',
  stats:(l)=>({damage:1+Math.floor(l/3),bossMult:.85+l*.14,splash:0,splashHits:0,chain:0,aoe:0,credits:1+l*.18,cooldown:0})},
 {id:'nova',name:'NOVA CANNON',tag:'BLAST',cost:2900,upgrade:520,max:5,
  desc:'Detonates a shockwave at the impact point. Huge area, long recharge.',
  stats:(l)=>({damage:1,bossMult:1.1+l*.2,splash:0,splashHits:0,chain:0,aoe:70+l*20,credits:1,cooldown:.66-l*.05})}
];

const v14HazardTypes={
 gravity:{name:'GRAVITY WELL',desc:'Hostiles fall considerably faster.'},
 meteor:{name:'METEOR FIELD',desc:'Burning debris rains down — tap it before it lands.'},
 fog:{name:'ION FOG',desc:'Visibility collapses around the reactor.'},
 emp:{name:'EMP PULSES',desc:'Overdrive and Blast go offline in bursts.'},
 swarm:{name:'SWARM SURGE',desc:'Sudden reinforcement waves between objectives.'}
};

/* Fifteen hand-tuned stages. `kind` decides the objective, everything else layers on top of the
   shared difficulty curve in v14StageCurve so the ramp stays readable in one place. */
const v14StageBlueprints=[
 {name:'FIRST CONTACT',world:0,kind:'purge',target:12,brief:'Scout wave inbound. Clear the approach vector.'},
 {name:'FORGE PATROL',world:0,kind:'purge',target:16,brief:'Heavier patrol rotation. Keep the reactor clean.'},
 {name:'IRON TIDE',world:0,kind:'elite',target:8,brief:'Iron Sentinels lead the push. Break the armour.',pool:['armored','armored','normal','splitter']},
 {name:'WARDEN AWAKENS',world:0,kind:'boss',brief:'The Singularity Warden has woken. Shatter every weak point.'},
 {name:'RIFT CROSSING',world:1,kind:'purge',target:20,hazards:['gravity'],brief:'Rift gravity is dragging hostiles down twice as fast.'},
 {name:'CRYSTAL STORM',world:1,kind:'survive',duration:45,hazards:['meteor'],brief:'Hold the line for 45 seconds through the debris field.'},
 {name:'PRISM HUNT',world:1,kind:'perfect',target:14,brief:'Precision contract: land 14 PERFECT strikes.'},
 {name:'HYDRA PROTOCOL',world:1,kind:'boss',brief:'The Prism Hydra splits its cores. Track them and strike.'},
 {name:'SOLAR APPROACH',world:2,kind:'purge',target:26,hazards:['fog'],brief:'Ion fog blinds the outer ring. Trust the silhouettes.'},
 {name:'EMBER SIEGE',world:2,kind:'elite',target:12,hazards:['meteor'],brief:'Siege armour under a meteor field. Prioritise ruthlessly.',pool:['armored','armored','bomb','normal']},
 {name:'TEMPLE OF FIRE',world:2,kind:'survive',duration:60,hazards:['emp','swarm'],brief:'EMP pulses will cut your powers. Survive a full minute.'},
 {name:'SOLAR COLOSSUS',world:2,kind:'boss',brief:'A titan of the temple. Three phases, no mercy.'},
 {name:'VOID DESCENT',world:3,kind:'purge',target:32,hazards:['fog','gravity'],brief:'Blind descent under crushing gravity.'},
 {name:'SERAPH TRIAL',world:3,kind:'perfect',target:20,hazards:['emp'],brief:'Twenty PERFECT strikes while the EMP field cycles.'},
 {name:'OMEGA GATE',world:3,kind:'gauntlet',target:2,hazards:['swarm'],brief:'Two titans guard the gate. Bring everything you own.'}
];

function v14StageCurve(index){
 const t=(index-1)/Math.max(1,v14StageBlueprints.length-1);
 return{
  speed:1+t*.85,
  hp:1+Math.round(t*2),
  spawn:Math.max(.42,1-t*.44),
  projectile:1+t*.6,
  bossHp:1+t*1.15
 };
}

function v14Stage(index){
 const blueprint=v14StageBlueprints[index-1];
 if(!blueprint)return null;
 const curve=v14StageCurve(index);
 const boss=blueprint.kind==='boss'||blueprint.kind==='gauntlet';
 return Object.assign({
  index,
  id:'stage'+index,
  hazards:[],
  pool:['normal','normal','normal','armored','bomb','shard','splitter'],
  target:blueprint.kind==='survive'?0:12,
  duration:0,
  reward:Math.round((140+index*52)*(boss?1.45:1)),
  shards:boss?18:6+Math.floor(index/2),
  curve
 },blueprint);
}

const v14StageCount=v14StageBlueprints.length;

function v14Defaults(){
 return{
  schema:V14_SCHEMA,
  unlocked:1,
  lastStage:1,
  stars:{},
  best:{},
  credits:300,
  weapon:'pulse',
  weapons:{pulse:{owned:true,level:1}},
  character:'vanguard',
  characters:{vanguard:{owned:true}},
  totals:{stagesCleared:0,kills:0,creditsEarned:0},
  updatedAt:0
 };
}

/* Migration is deliberately tolerant: a partially written or older payload still boots with
   defaults filled in rather than wiping a player's progress. */
function v14Migrate(raw){
 const base=v14Defaults();
 if(!raw||typeof raw!=='object')return base;
 const next=Object.assign(base,raw,{schema:V14_SCHEMA});
 next.stars=Object.assign({},raw.stars);
 next.best=Object.assign({},raw.best);
 next.totals=Object.assign(base.totals,raw.totals);
 next.weapons=Object.assign({},raw.weapons);
 next.characters=Object.assign({},raw.characters);
 if(!next.weapons.pulse)next.weapons.pulse={owned:true,level:1};
 if(!next.characters.vanguard)next.characters.vanguard={owned:true};
 for(const weapon of v14Weapons){
  const entry=next.weapons[weapon.id];
  if(entry)entry.level=Math.max(1,Math.min(weapon.max,Math.round(entry.level||1)));
 }
 if(!next.weapons[next.weapon]?.owned)next.weapon='pulse';
 if(!next.characters[next.character]?.owned)next.character='vanguard';
 next.credits=Math.max(0,Math.round(next.credits||0));
 next.unlocked=Math.max(1,Math.min(v14StageCount,Math.round(next.unlocked||1)));
 next.lastStage=Math.max(1,Math.min(next.unlocked,Math.round(next.lastStage||1)));
 return next;
}

let v14Save=v14Defaults();
try{v14Save=v14Migrate(JSON.parse(localStorage.getItem(V14_SAVE_KEY)||'null'));}catch{v14Save=v14Defaults();}

function v14Persist(){
 v14Save.updatedAt=Date.now();
 try{localStorage.setItem(V14_SAVE_KEY,JSON.stringify(v14Save));}catch{}
}

/* Server-side saves are the next step for this data; these two are the seam it will plug into. */
function v14ExportSave(){return JSON.stringify(v14Save);}
function v14ImportSave(payload){
 try{
  v14Save=v14Migrate(typeof payload==='string'?JSON.parse(payload):payload);
  v14Persist();
  return true;
 }catch{return false;}
}

function v14Character(id=v14Save.character){return v14Characters.find((c)=>c.id===id)||v14Characters[0];}
function v14WeaponDef(id=v14Save.weapon){return v14Weapons.find((w)=>w.id===id)||v14Weapons[0];}
function v14WeaponLevel(id=v14Save.weapon){return v14Save.weapons[id]?.level||1;}
function v14WeaponStats(id=v14Save.weapon){const def=v14WeaponDef(id);return def.stats(v14WeaponLevel(def.id));}
function v14UpgradeCost(id){const def=v14WeaponDef(id);return Math.round(def.upgrade*Math.pow(1.55,v14WeaponLevel(def.id)-1));}
function v14Owned(collection,id){return Boolean(v14Save[collection][id]?.owned);}

/* Duels strip the economic and damage perks so a bigger wallet can never out-stat a rival.
   Only the feel-based perks (PERFECT window, charge rates) carry into live play. */
function v14Mods(duel=false){
 const character=v14Character();
 const mods=Object.assign({perfect:1,damage:1,overdrive:1,shields:0,credits:1,score:1,blast:1},character.mods);
 if(duel){mods.damage=1;mods.credits=1;mods.score=1;}
 return mods;
}

function v14Stars(index){return v14Save.stars[index]||0;}
function v14StageUnlocked(index){return index<=v14Save.unlocked;}
function v14TotalStars(){return Object.values(v14Save.stars).reduce((sum,value)=>sum+value,0);}

function v14AddCredits(amount){
 const gain=Math.max(0,Math.round(amount));
 v14Save.credits+=gain;
 v14Save.totals.creditsEarned+=gain;
 return gain;
}

function v14Spend(amount){
 if(v14Save.credits<amount)return false;
 v14Save.credits-=amount;
 v14Persist();
 return true;
}

function v14RecordStage(index,stars,scoreValue){
 v14Save.stars[index]=Math.max(v14Stars(index),stars);
 v14Save.best[index]=Math.max(v14Save.best[index]||0,Math.floor(scoreValue));
 v14Save.lastStage=index;
 if(index>=v14Save.unlocked&&index<v14StageCount)v14Save.unlocked=index+1;
 v14Save.totals.stagesCleared++;
 v14Persist();
}
