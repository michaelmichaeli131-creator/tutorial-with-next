  perk:'Overdrive charges 30% faster',mods:{overdrive:1.3}},
 {id:'warden',name:'FROST WARDEN',frame:'warden',role:'DEFENCE',cost:2800,c1:'#eaffff',c2:'#3cb6ff',accent:'#cdf3ff',
