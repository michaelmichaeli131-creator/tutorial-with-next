 {id:'omega',name:'OMEGA PRIME',frame:'omega',role:'MASTERY',cost:5400,c1:'#ffffff',c2:'#ff3b62',accent:'#ffd9e2',
  perk:'+12% score and 25% faster Reactor Blast',mods:{score:1.12,blast:1.25}}
