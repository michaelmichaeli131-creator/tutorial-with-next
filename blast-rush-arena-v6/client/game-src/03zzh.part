/* V60 — the band you could not see.

   V57 pays up to 4.6x for kills deep in the arena, and the whole design rests on the player being
   able to see where that starts. Captured against a populated arena, it does not: the saturation line
   is faintly readable and the band itself is invisible.

   The cause is a straightforward rendering mistake, and it is worth naming because it is easy to
   repeat. The band was drawn with `globalCompositeOperation='lighter'` — an additive wash. Additive
   drawing adds light, so it is only visible over something dark. Three of the four worlds put a lit
   city skyline or a bright planet exactly where the band sits, and adding a few percent of light to
   an already-bright cityscape produces nothing the eye can find. The band was legible in the empty
   test arena I first checked it in and invisible in the game.

   So the rule is redrawn to be readable regardless of what is behind it, which means it cannot rely
   on adding light:

   1. **Darken above, not brighten below.** Everything shallower than the band is pushed down a little
      with a normal-composite dark wash. Contrast against a bright background needs subtraction, and
      it makes the band the bright region by comparison on any world.
   2. **Edges rather than fills.** A labelled entry line where the payout starts, a brighter line
      where it saturates, and tick marks down both sides — a marked zone on a floor, like a landing
      pad. Edges survive a busy background in a way a wash never does.
   3. **Say the number.** "STRIKE x2" at the entry, "x4.6" at saturation. The literature on Duolingo's
      streak is blunt about this: an eight-word explanation of the mechanic was worth more than most
      of the feature work around it. A multiplier the player has to infer from floating numbers is a
      mechanic most players will never find.

   The band still brightens as hostiles enter it, because "these are worth more right now" is the
   moment the rule teaches itself. */

const V60={
 /* How far the area above the band is pushed down. Subtle: this is contrast, not a vignette, and the
    top of the arena still has to be a place you can see and fight in. */
 dim:.28,
 tick:9,
 label:'STRIKE'
};

/* Replaces V57's own drawing wrapper rather than layering over it — two bands drawn on top of each
   other would be worse than either. V57's scoring is untouched; this is only how it is shown. */
const v60DrawBase=v57Draw;
drawReactor=function(){
 const line=v57Line();
 const top=line*V57.start;
 const full=line*V57.full;
 let live=0;
 for(const o of game.orbs)if(v57Depth(o.y)>.15)live++;
 const heat=Math.min(1,live/4);
 const world=worlds[game.world%worlds.length];

 ctx.save();

 /* 1. Everything above the band steps back. Normal composite, so it works over a lit skyline as
       well as over empty space -- which is the entire fix. */
 ctx.fillStyle=`rgba(2,6,16,${V60.dim})`;
 ctx.fillRect(0,0,W,top);

 /* 2. The zone markings. */
 ctx.strokeStyle=world.accent;
 ctx.lineCap='round';

 /* Entry: where the payout starts climbing. Dashed and dimmer than the saturation line, so the two
    read as "from here" and "best here" rather than as two equal rules. */
 ctx.globalAlpha=.34+heat*.3;
 ctx.lineWidth=1.4;
 ctx.setLineDash([9,10]);
 ctx.beginPath();ctx.moveTo(0,top);ctx.lineTo(W,top);ctx.stroke();

 /* Saturation: solid, brighter, the line past which nothing more is gained. */
 ctx.globalAlpha=.5+heat*.4;
 ctx.lineWidth=2;
 ctx.setLineDash([]);
 ctx.beginPath();ctx.moveTo(0,full);ctx.lineTo(W,full);ctx.stroke();

 /* Side ticks. Cheap, and they are what makes the region between the two lines read as one marked
    zone instead of as two unrelated horizontal rules. */
 ctx.globalAlpha=.3+heat*.35;
 ctx.lineWidth=2;
 for(let y=top;y<=line;y+=26){
  ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(V60.tick,y);ctx.stroke();
  ctx.beginPath();ctx.moveTo(W-V60.tick,y);ctx.lineTo(W,y);ctx.stroke();
 }

 /* 3. The number, because a multiplier nobody can read is a multiplier nobody will play for. */
 ctx.setLineDash([]);
 ctx.globalAlpha=.62+heat*.38;
 ctx.fillStyle=world.accent;
 ctx.font=`800 ${isMobile?10:11}px system-ui`;
 ctx.textAlign='left';
 ctx.textBaseline='bottom';
 ctx.fillText(`${V60.label} ×${(1+(V57.pay-1)*.5).toFixed(1)}`,V60.tick+6,top-4);
 ctx.textBaseline='top';
 ctx.fillText(`×${V57.pay.toFixed(1)}`,V60.tick+6,full+4);
 ctx.restore();

 v60DrawBase();
};
