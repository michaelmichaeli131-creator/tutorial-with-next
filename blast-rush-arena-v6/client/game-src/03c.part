const v11Deaths=[];
const v11Shockwaves=[];
const v11Sparks=[];
const v11Camera={zoom:0,kickX:0,kickY:0,freeze:0};
function v11ColorFor(o){const w=worlds[game.world%worlds.length];return o.type==='bomb'?'#ff3f61':o.type==='shard'?'#69ffb5':o.type==='armored'?'#61a5ff':o.type==='rival'?currentSkin(o.skin).c1:o.type==='splitter'?'#ffe05f':w.enemy;}
function v11Burst(o,perfect){const color=v11ColorFor(o),parts=isMobile?7:12;for(let i=0;i<parts;i++){const a=Math.PI*2*i/parts+rng()*.35,s=(75+rng()*210)*(perfect?1.35:1);v11Deaths.push({x:o.x,y:o.y,vx:Math.cos(a)*s,vy:Math.sin(a)*s-35,rot:rng()*6.28,vr:(rng()-.5)*9,life:.65+rng()*.28,max:1,size:(o.r/30)*(5+rng()*10),color,kind:i%3});}v11Shockwaves.push({x:o.x,y:o.y,r:o.r*.4,life:.48,max:.48,color});v11Camera.zoom=Math.max(v11Camera.zoom,perfect?.035:.018);v11Camera.kickX+=(rng()-.5)*(perfect?15:8);v11Camera.kickY+=(rng()-.5)*(perfect?15:8);if(perfect)v11Camera.freeze=Math.max(v11Camera.freeze,.045);}
const v11HitBase=hitOrb;
hitOrb=function(o,x,y,chain=false){const before=o.hp,d=Math.hypot(x-o.x,y-o.y),perfect=d<o.r*game.perfectWindow;v11HitBase(o,x,y,chain);if(before<=1)v11Burst(o,perfect);else{v11Shockwaves.push({x:o.x,y:o.y,r:o.r*.25,life:.22,max:.22,color:v11ColorFor(o)});for(let i=0;i<5;i++)v11Sparks.push({x:o.x,y:o.y,vx:(rng()-.5)*240,vy:(rng()-.5)*240,life:.28,max:.28,color:v11ColorFor(o)});v11Camera.kickX+=(rng()-.5)*5;v11Camera.kickY+=(rng()-.5)*5;}};
const v11UpdateBase=update;
update=function(dt){if(v11Camera.freeze>0){v11Camera.freeze-=dt;dt*=.08;}v11UpdateBase(dt);v11Camera.zoom*=.84;v11Camera.kickX*=.76;v11Camera.kickY*=.76;for(const o of game.orbs){o.v11Age=(o.v11Age||0)+dt;o.v11Attack=Math.max(0,Math.min(1,(o.y-H*.58)/(H*.28)));o.v11Hit=Math.max(0,(o.v11Hit||0)-dt*5);}for(let i=v11Deaths.length-1;i>=0;i--){const p=v11Deaths[i];p.x+=p.vx*dt;p.y+=p.vy*dt;p.vy+=330*dt;p.rot+=p.vr*dt;p.life-=dt;if(p.life<=0)v11Deaths.splice(i,1);}for(let i=v11Shockwaves.length-1;i>=0;i--){const s=v11Shockwaves[i];s.r+=420*dt;s.life-=dt;if(s.life<=0)v11Shockwaves.splice(i,1);}for(let i=v11Sparks.length-1;i>=0;i--){const s=v11Sparks[i];s.x+=s.vx*dt;s.y+=s.vy*dt;s.vx*=.9;s.vy*=.9;s.life-=dt;if(s.life<=0)v11Sparks.splice(i,1);}};
const v11DrawOrbBase=drawOrb;
drawOrb=function(o,w){const attack=o.v11Attack||0,breath=1+Math.sin((o.v11Age||0)*6+o.variant)*.035,squash=1-attack*.16,stretch=1+attack*.24,tilt=Math.sin(o.phase*.7+o.variant)*(.05+attack*.12);ctx.save();ctx.translate(o.x,o.y);ctx.rotate(tilt);ctx.scale(breath*squash,breath*stretch);ctx.translate(-o.x,-o.y);if(attack>.05){ctx.globalCompositeOperation='lighter';ctx.strokeStyle=v11ColorFor(o)+'55';ctx.lineWidth=2;ctx.beginPath();ctx.moveTo(o.x,o.y-o.r*1.3);ctx.lineTo(o.x+(Math.sin(o.phase)*18),o.y-o.r*2.2-attack*30);ctx.stroke();ctx.globalCompositeOperation='source-over';}v11DrawOrbBase(o,w);ctx.restore();};
const v11DrawBossBase=drawBoss;
drawBoss=function(b,w){const phase=b.phase||1,breath=1+Math.sin(b.t*1.7)*.025,rage=phase===3?.05:0;ctx.save();ctx.translate(b.x,b.y);ctx.scale(breath+rage,breath-rage*.35);ctx.translate(-b.x,-b.y);v11DrawBossBase(b,w);ctx.restore();if(phase===3){ctx.save();ctx.globalCompositeOperation='lighter';ctx.strokeStyle=w.enemy+'66';ctx.lineWidth=3;for(let i=0;i<8;i++){const a=b.t*.8+i*Math.PI/4,r=b.r*(1.2+.08*Math.sin(b.t*3+i));ctx.beginPath();ctx.moveTo(b.x+Math.cos(a)*r,b.y+Math.sin(a)*r);ctx.lineTo(b.x+Math.cos(a)*r*1.42,b.y+Math.sin(a)*r*1.42);ctx.stroke();}ctx.restore();}};
const v11DrawBase=draw;
draw=function(){const z=1+v11Camera.zoom,kx=v11Camera.kickX,ky=v11Camera.kickY;ctx.save();ctx.translate(W/2+kx,H/2+ky);ctx.scale(z,z);ctx.translate(-W/2,-H/2);v11DrawBase();ctx.restore();ctx.save();ctx.globalCompositeOperation='lighter';for(const s of v11Shockwaves){ctx.globalAlpha=Math.max(0,s.life/s.max);ctx.strokeStyle=s.color;ctx.lineWidth=2+4*(s.life/s.max);ctx.beginPath();ctx.arc(s.x,s.y,s.r,0,Math.PI*2);ctx.stroke();}for(const p of v11Deaths){ctx.save();ctx.globalAlpha=Math.max(0,p.life/p.max);ctx.translate(p.x,p.y);ctx.rotate(p.rot);ctx.fillStyle=p.color;ctx.shadowBlur=16;ctx.shadowColor=p.color;if(p.kind===0){ctx.fillRect(-p.size*.7,-p.size*.25,p.size*1.4,p.size*.5);}else if(p.kind===1){ctx.beginPath();ctx.moveTo(0,-p.size);ctx.lineTo(p.size*.75,p.size*.7);ctx.lineTo(-p.size*.75,p.size*.7);ctx.closePath();ctx.fill();}else{ctx.beginPath();ctx.arc(0,0,p.size*.55,0,Math.PI*2);ctx.fill();}ctx.restore();}for(const s of v11Sparks){ctx.globalAlpha=s.life/s.max;ctx.strokeStyle=s.color;ctx.lineWidth=2;ctx.beginPath();ctx.moveTo(s.x,s.y);ctx.lineTo(s.x-s.vx*.035,s.y-s.vy*.035);ctx.stroke();}ctx.restore();ctx.globalAlpha=1;};
const v11CinematicBase=cinematic;
cinematic=function(text){v11Camera.zoom=.055;v11Camera.freeze=.065;v11CinematicBase(text);};
