let lobbyWatch=0,tableRefresh=0;
function setLobbyStatus(title,code='••••••',hint='Keep this window open. The match starts automatically when a rival connects.'){$('lobbyTitle').textContent=title;$('roomCodeDisplay').textContent=code;$('lobbyHint').textContent=hint;showScreen('lobbyScreen');}
async function runLobbyAction(button,working,fn){if(button.disabled)return false;const old=button.textContent;button.disabled=true;button.textContent=working;try{const ok=await fn();if(!ok)throw new Error('Could not connect to the arena server');return true;}catch(e){toast(e.message||'MULTIPLAYER UNAVAILABLE');showScreen('socialScreen');return false;}finally{button.disabled=false;button.textContent=old;}}
async function startQuickMatch(){audio.start();setLobbyStatus('FINDING YOUR RIVAL','LIVE','One tap only — we will pair you with the next available pilot.');$('opponentName').textContent='SCANNING…';$('opponentStatus').textContent='MATCHMAKING';const ok=await BlastNetwork.quickMatch();if(!ok){toast('COULD NOT ENTER MATCHMAKING');home();}}
bind('soloBtn',()=>begin('solo'));bind('gauntletBtn',()=>begin('gauntlet'));bind('quickBtn',startQuickMatch);bind('socialBtn',()=>{showScreen('socialScreen');loadTables();clearInterval(tableRefresh);tableRefresh=setInterval(()=>{if($('socialScreen').classList.contains('active'))loadTables(true);},4000);});document.querySelectorAll('[data-back]').forEach(b=>b.onclick=()=>{clearInterval(tableRefresh);showScreen('menuScreen');updateMenu();});bind('profileBtn',()=>{renderSkins();$('pilotNameInput').value=BlastNetwork.playerName;showScreen('profileScreen');});bind('settingsBtn',()=>{audio.start();v10ApplyVolumes();showScreen('settingsScreen');});bind('overdriveBtn',activateOverdrive);bind('blastBtn',activateBlast);bind('pressureBtn',sendPressure);bind('volleyBtn',sendCore);bind('pauseBtn',()=>{if(game.mode==='duel')return;game.paused=true;showScreen('pauseScreen');});bind('resumeBtn',()=>{showScreen(null);game.paused=false;});bind('restartBtn',()=>begin(game.mode));bind('homeBtn',home);bind('resultHomeBtn',home);bind('againBtn',()=>begin(game.mode==='duel'?'solo':game.mode));bind('rematchBtn',()=>{BlastNetwork.rematch();setLobbyStatus('REMATCH REQUESTED');});bind('fullscreenBtn',()=>document.documentElement.requestFullscreen?.());
bind('createPublicBtn',async()=>{const b=$('createPublicBtn');await runLobbyAction(b,'OPENING ARENA…',async()=>{setLobbyStatus('OPENING PUBLIC ARENA');return BlastNetwork.createRoom({visibility:'public',tableName:$('tableNameInput').value});});});
bind('createPrivateBtn',async()=>{const b=$('createPrivateBtn');await runLobbyAction(b,'CREATING INVITE…',async()=>{setLobbyStatus('CREATING PRIVATE ARENA');return BlastNetwork.createRoom({visibility:'private'});});});
bind('joinCodeBtn',async()=>{const code=$('roomCodeInput').value.trim().toUpperCase();if(code.length<4)return toast('ENTER A VALID ROOM CODE');const b=$('joinCodeBtn');await runLobbyAction(b,'JOINING…',async()=>{setLobbyStatus('JOINING FRIEND','••••••');return BlastNetwork.joinRoom(code);});});bind('refreshTablesBtn',()=>loadTables());bind('leaveLobbyBtn',()=>{clearTimeout(lobbyWatch);BlastNetwork.leave();home();});bind('copyInviteBtn',copyInvite);bind('shareInviteBtn',shareInvite);bind('shareChallengeBtn',shareChallenge);
$('pilotNameInput').addEventListener('change',()=>{BlastNetwork.setName($('pilotNameInput').value);updateMenu();});$('roomCodeInput').addEventListener('input',e=>e.target.value=e.target.value.toUpperCase().replace(/[^A-Z0-9]/g,''));$('roomCodeInput').addEventListener('keydown',e=>{if(e.key==='Enter')$('joinCodeBtn').click();});$('musicSlider').value=save.music;$('sfxSlider').value=save.sfx;$('musicValue').textContent=save.music+'%';$('sfxValue').textContent=save.sfx+'%';$('comfortToggle').checked=save.comfort;$('shakeToggle').checked=save.shake;$('musicSlider').oninput=e=>{save.music=+e.target.value;$('musicValue').textContent=save.music+'%';persist();v10ApplyVolumes();};$('sfxSlider').oninput=e=>{save.sfx=+e.target.value;$('sfxValue').textContent=save.sfx+'%';persist();v10ApplyVolumes();audio.sfx('hit');};$('comfortToggle').onchange=e=>{save.comfort=e.target.checked;persist();};$('shakeToggle').onchange=e=>{save.shake=e.target.checked;persist();};
addEventListener('keydown',e=>{if(e.code==='Space'){e.preventDefault();activateOverdrive();}if(e.key.toLowerCase()==='b')activateBlast();if(e.key.toLowerCase()==='q')sendPressure();if(e.key.toLowerCase()==='s')sendCore();if(e.key.toLowerCase()==='p'&&game.mode!=='duel'){game.paused=!game.paused;showScreen(game.paused?'pauseScreen':null);}if(e.key.toLowerCase()==='f')document.documentElement.requestFullscreen?.();});
function home(){clearTimeout(lobbyWatch);clearInterval(tableRefresh);game.running=false;game.paused=false;hideGame();showScreen('menuScreen');updateMenu();}
function renderSkins(){$('skinGrid').innerHTML='';for(const s of skins){const unlocked=save.unlocked.includes(s.id),card=document.createElement('article');card.className='skin-card'+(save.skin===s.id?' selected':'')+(unlocked?'':' locked');const orb=document.createElement('span');orb.className='skin-orb large';paintSkinElement(orb,s.id);card.append(orb);const h=document.createElement('h3');h.textContent=s.name;card.append(h);const b=document.createElement('button');b.className=unlocked?'secondary':'primary';b.textContent=unlocked?(save.skin===s.id?'EQUIPPED':'EQUIP'):`UNLOCK • ${s.cost}`;b.onclick=()=>{if(!unlocked){if(save.shards<s.cost)return toast('NOT ENOUGH SHARDS');save.shards-=s.cost;save.unlocked.push(s.id);audio.start();audio.sfx('perfect');}save.skin=s.id;BlastNetwork.setSkin(s.id);persist();renderSkins();updateMenu();};card.append(b);$('skinGrid').append(card);}}
async function loadTables(silent=false){if(!silent)$('tableList').innerHTML='<p class="scan-line">Scanning live arenas…</p>';try{const data=await BlastNetwork.tables(),tables=data.tables||data;if(!tables.length){$('tableList').innerHTML='<p>No open arenas yet. Quick Duel will still match you automatically.</p>';return;}$('tableList').innerHTML='';for(const t of tables){const row=document.createElement('div');row.className='table-row';row.innerHTML=`<span><b>${escapeHtml(t.title)}</b><small>HOST • ${escapeHtml(t.hostName)} • READY NOW</small></span><code>${t.code}</code><button class="primary compact">JOIN</button>`;row.querySelector('button').onclick=async()=>{setLobbyStatus('JOINING LIVE ARENA');const ok=await BlastNetwork.joinRoom(t.code);if(!ok){toast('COULD NOT JOIN THIS ARENA');showScreen('socialScreen');}};$('tableList').append(row);}}catch(e){$('tableList').innerHTML=`<p>${escapeHtml(e.message)}</p>`;}}
function escapeHtml(v){return String(v).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
function inviteUrl(){const code=game.roomCode||$('roomCodeDisplay').textContent;const u=new URL(location.href);u.search='';u.hash='';u.searchParams.set('room',code);return u.href;}
async function copyText(text){if(navigator.clipboard&&window.isSecureContext)return navigator.clipboard.writeText(text);const ta=document.createElement('textarea');ta.value=text;ta.style.position='fixed';ta.style.opacity='0';document.body.appendChild(ta);ta.select();document.execCommand('copy');ta.remove();}
async function copyInvite(){const code=game.roomCode||$('roomCodeDisplay').textContent;if(!/^[A-Z0-9]{4,8}$/.test(code))return toast('ROOM IS STILL BEING CREATED');await copyText(inviteUrl());toast('INVITE LINK COPIED');}
async function shareInvite(){const code=game.roomCode||$('roomCodeDisplay').textContent;if(!/^[A-Z0-9]{4,8}$/.test(code))return toast('ROOM IS STILL BEING CREATED');const data={title:'Blast Rush Arena',text:`Join my live arena • code ${code}`,url:inviteUrl()};if(navigator.share)try{return await navigator.share(data)}catch{}await copyInvite();}
async function shareChallenge(){if(!game.lastResult)return;try{const p=await BlastNetwork.createChallenge(game.lastResult),u=new URL(location.href);u.search='';u.searchParams.set('challenge',p.challenge.code);const text=`I scored ${format(game.lastResult.score)} in Blast Rush Arena. Beat me.`;if(navigator.share)await navigator.share({title:'Blast Rush Challenge',text,url:u.href});else{await copyText(text+'\n'+u.href);toast('CHALLENGE COPIED');}}catch(e){toast(e.message);}}
function showLobby(m){clearTimeout(lobbyWatch);game.roomCode=m.code;$('roomCodeDisplay').textContent=m.code;$('lobbyTitle').textContent=m.title||'LIVE TABLE';$('lobbyHint').textContent=m.visibility==='private'?'Send the link or code. Your match starts automatically when your friend joins.':'Your arena is public. The next pilot can join instantly.';const me=m.players?.find(p=>p.id===BlastNetwork.playerId),op=m.players?.find(p=>p.id!==BlastNetwork.playerId);$('meName').textContent=me?.name||BlastNetwork.playerName;paintSkinElement($('meSkin'),me?.skin||save.skin);$('opponentName').textContent=op?.name||'WAITING…';$('opponentStatus').textContent=op?'CONNECTED':'OPEN SLOT';$('opponentSkin').parentElement.classList.toggle('waiting',!op);if(op)paintSkinElement($('opponentSkin'),op.skin);showScreen('lobbyScreen');if(!op)lobbyWatch=setTimeout(()=>toast(m.visibility==='private'?'SHARE THE INVITE LINK':'ARENA IS LIVE — WAITING FOR A PILOT'),2500);}
function handleMatchState(m){const me=m.players.find(p=>p.id===BlastNetwork.playerId),op=m.players.find(p=>p.id!==BlastNetwork.playerId);if(me){game.score=me.score;game.pressure=me.pressure;game.ammo=me.ammo;}if(op){game.rival=op;$('rivalName').textContent=op.name;$('rivalScore').textContent=format(op.score);$('rivalState').textContent=op.connected?'CONNECTED':'RECONNECTING';}game.duelEndsAt=m.endsAt;}
BlastNetwork.addEventListener('room_created',e=>showLobby(e.detail));BlastNetwork.addEventListener('room_joined',e=>showLobby(e.detail));BlastNetwork.addEventListener('queue',()=>{setLobbyStatus('FINDING YOUR RIVAL','LIVE','Stay here — the game launches automatically as soon as another pilot taps Quick Duel.');$('opponentName').textContent='SCANNING…';$('opponentStatus').textContent='MATCHMAKING';});BlastNetwork.addEventListener('match_found',e=>{const m=e.detail;showLobby(m);game.roomCode=m.code;let n=Math.max(1,Math.ceil((m.startsAt-Date.now())/1000));$('countdown').classList.remove('hidden');$('countdown').textContent=n;const timer=setInterval(()=>{n=Math.ceil((m.startsAt-Date.now())/1000);$('countdown').textContent=n>0?n:'BLAST';if(n<=0){clearInterval(timer);setTimeout(()=>$('countdown').classList.add('hidden'),450);}},160);});BlastNetwork.addEventListener('match_start',e=>{const m=e.detail;game.duelEndsAt=m.endsAt;begin('duel',m.seed);});BlastNetwork.addEventListener('match_state',e=>handleMatchState(e.detail));BlastNetwork.addEventListener('rival_core',e=>spawnRival(e.detail.core));BlastNetwork.addEventListener('ammo_gained',e=>{game.ammo=e.detail.ammo;toast('VOLLEY CORE READY');audio.sfx('perfect');});BlastNetwork.addEventListener('core_launched',e=>{game.ammo=e.detail.ammo;});BlastNetwork.addEventListener('opponent_attack',e=>applyHazard(e.detail.kind,e.detail.durationMs));BlastNetwork.addEventListener('match_end',e=>{const m=e.detail,me=m.standings.find(p=>p.id===BlastNetwork.playerId),op=m.standings.find(p=>p.id!==BlastNetwork.playerId),won=m.winnerId===BlastNetwork.playerId,text=m.winnerId===null?'DRAW SIGNAL':won?`VICTORY • ${format((me?.score||0)-(op?.score||0))} POINT LEAD`:`DEFEAT • ${format((op?.score||0)-(me?.score||0))} POINT GAP`;game.score=me?.score||game.score;finish(won,text);});BlastNetwork.addEventListener('error',e=>{toast(e.detail.message||'SERVER ERROR');if($('lobbyScreen').classList.contains('active'))setTimeout(()=>showScreen('socialScreen'),700);});BlastNetwork.addEventListener('player_connection',e=>{if(e.detail.playerId!==BlastNetwork.playerId)$('rivalState').textContent=e.detail.connected?'CONNECTED':'RECONNECTING';});BlastNetwork.addEventListener('connection',e=>{document.body.classList.toggle('offline',!e.detail.connected);});
async function handleUrl(){const q=new URLSearchParams(location.search),room=(q.get('room')||'').toUpperCase().replace(/[^A-Z0-9]/g,''),challenge=q.get('challenge');if(room){setLobbyStatus('JOINING FRIEND','••••••','Connecting to the shared arena…');const ok=await BlastNetwork.joinRoom(room);if(!ok){toast('INVITE COULD NOT BE OPENED');showScreen('socialScreen');$('roomCodeInput').value=room;}}if(challenge){try{const p=await BlastNetwork.getChallenge(challenge),c=p.challenge||p;toast(`BEAT ${c.creatorName.toUpperCase()} • ${format(c.score)}`);begin('solo',c.seed);}catch(e){toast(e.message);}}}
updateMenu();BlastNetwork.connect().then(handleUrl);if('serviceWorker' in navigator&&location.protocol.startsWith('http'))navigator.serviceWorker.register('/sw.js').catch(()=>{});
})();