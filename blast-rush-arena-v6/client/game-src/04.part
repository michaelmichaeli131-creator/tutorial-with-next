bind('soloBtn',()=>begin('solo'));bind('gauntletBtn',()=>begin('gauntlet'));bind('quickBtn',async()=>{audio.start();showScreen('lobbyScreen');$('lobbyTitle').textContent='SEARCHING THE COSMOS';$('roomCodeDisplay').textContent='QUICK';await BlastNetwork.quickMatch();});bind('socialBtn',()=>{showScreen('socialScreen');loadTables();});document.querySelectorAll('[data-back]').forEach(b=>b.onclick=()=>{showScreen('menuScreen');updateMenu();});bind('profileBtn',()=>{renderSkins();$('pilotNameInput').value=BlastNetwork.playerName;showScreen('profileScreen');});bind('settingsBtn',()=>showScreen('settingsScreen'));bind('overdriveBtn',activateOverdrive);bind('blastBtn',activateBlast);bind('pressureBtn',sendPressure);bind('volleyBtn',sendCore);bind('pauseBtn',()=>{if(game.mode==='duel')return;game.paused=true;showScreen('pauseScreen');});bind('resumeBtn',()=>{showScreen(null);game.paused=false;});bind('restartBtn',()=>begin(game.mode));bind('homeBtn',home);bind('resultHomeBtn',home);bind('againBtn',()=>begin(game.mode==='duel'?'solo':game.mode));bind('rematchBtn',()=>{BlastNetwork.rematch();showScreen('lobbyScreen');$('lobbyTitle').textContent='REMATCH REQUESTED';});bind('fullscreenBtn',()=>document.documentElement.requestFullscreen?.());bind('createPublicBtn',async()=>{await BlastNetwork.createRoom({visibility:'public',tableName:$('tableNameInput').value});showScreen('lobbyScreen');});bind('createPrivateBtn',async()=>{await BlastNetwork.createRoom({visibility:'private'});showScreen('lobbyScreen');});bind('joinCodeBtn',async()=>{await BlastNetwork.joinRoom($('roomCodeInput').value);showScreen('lobbyScreen');});bind('refreshTablesBtn',loadTables);bind('leaveLobbyBtn',()=>{BlastNetwork.leave();home();});bind('copyInviteBtn',copyInvite);bind('shareInviteBtn',shareInvite);bind('shareChallengeBtn',shareChallenge);
$('pilotNameInput').addEventListener('change',()=>{BlastNetwork.setName($('pilotNameInput').value);updateMenu();});$('roomCodeInput').addEventListener('input',e=>e.target.value=e.target.value.toUpperCase().replace(/[^A-Z0-9]/g,''));$('musicSlider').value=save.music;$('sfxSlider').value=save.sfx;$('comfortToggle').checked=save.comfort;$('shakeToggle').checked=save.shake;$('musicSlider').oninput=e=>{save.music=+e.target.value;persist();};$('sfxSlider').oninput=e=>{save.sfx=+e.target.value;persist();};$('comfortToggle').onchange=e=>{save.comfort=e.target.checked;persist();};$('shakeToggle').onchange=e=>{save.shake=e.target.checked;persist();};
addEventListener('keydown',e=>{if(e.code==='Space'){e.preventDefault();activateOverdrive();}if(e.key.toLowerCase()==='b')activateBlast();if(e.key.toLowerCase()==='q')sendPressure();if(e.key.toLowerCase()==='s')sendCore();if(e.key.toLowerCase()==='p'&&game.mode!=='duel'){game.paused=!game.paused;showScreen(game.paused?'pauseScreen':null);}if(e.key.toLowerCase()==='f')document.documentElement.requestFullscreen?.();});
function home(){game.running=false;game.paused=false;hideGame();showScreen('menuScreen');updateMenu();}
function renderSkins(){$('skinGrid').innerHTML='';for(const s of skins){const unlocked=save.unlocked.includes(s.id),card=document.createElement('article');card.className='skin-card'+(save.skin===s.id?' selected':'')+(unlocked?'':' locked');const orb=document.createElement('span');orb.className='skin-orb large';paintSkinElement(orb,s.id);card.append(orb);const h=document.createElement('h3');h.textContent=s.name;card.append(h);const b=document.createElement('button');b.className=unlocked?'secondary':'primary';b.textContent=unlocked?(save.skin===s.id?'EQUIPPED':'EQUIP'):`UNLOCK • ${s.cost}`;b.onclick=()=>{if(!unlocked){if(save.shards<s.cost)return toast('NOT ENOUGH SHARDS');save.shards-=s.cost;save.unlocked.push(s.id);audio.start();audio.sfx('perfect');}save.skin=s.id;BlastNetwork.setSkin(s.id);persist();renderSkins();updateMenu();};card.append(b);$('skinGrid').append(card);}}
async function loadTables(){$('tableList').innerHTML='<p>Scanning open arenas…</p>';try{const data=await BlastNetwork.tables(),tables=data.tables||data;if(!tables.length){$('tableList').innerHTML='<p>No open arenas. Create the first table.</p>';return;}$('tableList').innerHTML='';for(const t of tables){const row=document.createElement('div');row.className='table-row';row.innerHTML=`<span><b>${escapeHtml(t.title)}</b><small>HOST • ${escapeHtml(t.hostName)}</small></span><code>${t.code}</code><button class="primary compact">JOIN</button>`;row.querySelector('button').onclick=async()=>{await BlastNetwork.joinRoom(t.code);showScreen('lobbyScreen');};$('tableList').append(row);}}catch(e){$('tableList').innerHTML=`<p>${escapeHtml(e.message)}</p>`;}}
function escapeHtml(v){return String(v).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
function inviteUrl(){const u=new URL(location.href);u.search='';u.searchParams.set('room',game.roomCode||$('roomCodeDisplay').textContent);return u.href;}
async function copyInvite(){await navigator.clipboard?.writeText(inviteUrl());toast('INVITE LINK COPIED');}
async function shareInvite(){const data={title:'Blast Rush Arena',text:'Join my Titan Volley table',url:inviteUrl()};if(navigator.share)try{return await navigator.share(data)}catch{}await copyInvite();}
async function shareChallenge(){if(!game.lastResult)return;try{const p=await BlastNetwork.createChallenge(game.lastResult),u=new URL(location.href);u.search='';u.searchParams.set('challenge',p.challenge.code);const text=`I scored ${format(game.lastResult.score)} in Blast Rush Arena. Beat me.`;if(navigator.share)await navigator.share({title:'Blast Rush Challenge',text,url:u.href});else{await navigator.clipboard.writeText(text+'\n'+u.href);toast('CHALLENGE COPIED');}}catch(e){toast(e.message);}}
function showLobby(m){game.roomCode=m.code;$('roomCodeDisplay').textContent=m.code;$('lobbyTitle').textContent=m.title||'LIVE TABLE';const me=m.players?.find(p=>p.id===BlastNetwork.playerId),op=m.players?.find(p=>p.id!==BlastNetwork.playerId);$('meName').textContent=me?.name||BlastNetwork.playerName;paintSkinElement($('meSkin'),me?.skin||save.skin);$('opponentName').textContent=op?.name||'WAITING…';$('opponentStatus').textContent=op?'CONNECTED':'WAITING';$('opponentSkin').parentElement.classList.toggle('waiting',!op);if(op)paintSkinElement($('opponentSkin'),op.skin);showScreen('lobbyScreen');}
function handleMatchState(m){const me=m.players.find(p=>p.id===BlastNetwork.playerId),op=m.players.find(p=>p.id!==BlastNetwork.playerId);if(me){game.score=me.score;game.pressure=me.pressure;game.ammo=me.ammo;}if(op){game.rival=op;$('rivalName').textContent=op.name;$('rivalScore').textContent=format(op.score);$('rivalState').textContent=op.connected?'CONNECTED':'RECONNECTING';}game.duelEndsAt=m.endsAt;}
BlastNetwork.addEventListener('room_created',e=>showLobby(e.detail));BlastNetwork.addEventListener('room_joined',e=>showLobby(e.detail));BlastNetwork.addEventListener('queue',()=>{showScreen('lobbyScreen');$('lobbyTitle').textContent='SEARCHING FOR A RIVAL';$('roomCodeDisplay').textContent='••••••';});BlastNetwork.addEventListener('match_found',e=>{const m=e.detail;showLobby(m);game.roomCode=m.code;let n=3;$('countdown').classList.remove('hidden');$('countdown').textContent=n;const timer=setInterval(()=>{n--;$('countdown').textContent=n>0?n:'BLAST';if(n<=0){clearInterval(timer);setTimeout(()=>$('countdown').classList.add('hidden'),450);}},1000);});BlastNetwork.addEventListener('match_start',e=>{const m=e.detail;game.duelEndsAt=m.endsAt;begin('duel',m.seed);});BlastNetwork.addEventListener('match_state',e=>handleMatchState(e.detail));BlastNetwork.addEventListener('rival_core',e=>spawnRival(e.detail.core));BlastNetwork.addEventListener('ammo_gained',e=>{game.ammo=e.detail.ammo;toast('VOLLEY CORE READY');audio.sfx('perfect');});BlastNetwork.addEventListener('core_launched',e=>{game.ammo=e.detail.ammo;});BlastNetwork.addEventListener('opponent_attack',e=>applyHazard(e.detail.kind,e.detail.durationMs));BlastNetwork.addEventListener('match_end',e=>{const m=e.detail,me=m.standings.find(p=>p.id===BlastNetwork.playerId),op=m.standings.find(p=>p.id!==BlastNetwork.playerId),won=m.winnerId===BlastNetwork.playerId,text=m.winnerId===null?'DRAW SIGNAL':won?`VICTORY • ${format(me.score-op.score)} POINT LEAD`:`DEFEAT • ${format(op.score-me.score)} POINT GAP`;game.score=me?.score||game.score;finish(won,text);});BlastNetwork.addEventListener('error',e=>toast(e.detail.message||'SERVER ERROR'));BlastNetwork.addEventListener('player_connection',e=>{if(e.detail.playerId!==BlastNetwork.playerId)$('rivalState').textContent=e.detail.connected?'CONNECTED':'RECONNECTING';});
async function handleUrl(){const q=new URLSearchParams(location.search),room=q.get('room'),challenge=q.get('challenge');if(room){showScreen('socialScreen');$('roomCodeInput').value=room;await BlastNetwork.joinRoom(room);}if(challenge){try{const p=await BlastNetwork.getChallenge(challenge),c=p.challenge||p;toast(`BEAT ${c.creatorName.toUpperCase()} • ${format(c.score)}`);begin('solo',c.seed);}catch(e){toast(e.message);}}}
updateMenu();BlastNetwork.connect().then(handleUrl);if('serviceWorker' in navigator&&location.protocol.startsWith('http'))navigator.serviceWorker.register('/sw.js').catch(()=>{});
})();
