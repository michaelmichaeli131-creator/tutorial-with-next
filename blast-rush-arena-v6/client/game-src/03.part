function draw(){const w=worlds[game.world%worlds.length];const g=ctx.createRadialGradient(W*.5,H*.2,10,W*.5,H*.5,Math.max(W,H));g.addColorStop(0,w.bg[1]);g.addColorStop(1,w.bg[0]);ctx.fillStyle=g;ctx.fillRect(0,0,W,H);ctx.save();if(game.shake&&save.shake)ctx.translate((rng()-.5)*game.shake,(rng()-.5)*game.shake);drawBackground(w);drawReactor();for(const o of game.orbs)drawOrb(o,w);for(const p of game.projectiles)drawProjectile(p);if(game.boss)drawBoss(game.boss,w);for(const r of game.rings){ctx.globalAlpha=r.life/r.max;ctx.strokeStyle=r.color;ctx.lineWidth=3;ctx.beginPath();ctx.arc(r.x,r.y,r.r,0,Math.PI*2);ctx.stroke();}for(const p of game.particles){ctx.globalAlpha=Math.max(0,p.life/p.max);ctx.fillStyle=p.color;ctx.beginPath();ctx.arc(p.x,p.y,p.r,0,Math.PI*2);ctx.fill();}for(const t of game.texts){ctx.globalAlpha=t.life/t.max;ctx.fillStyle=t.color;ctx.font='900 18px Segoe UI';ctx.textAlign='center';ctx.fillText(t.text,t.x,t.y);}ctx.restore();ctx.globalAlpha=1;}
function drawBackground(w){ctx.globalAlpha=.35;for(let i=0;i<90;i++){const x=(i*137+game.elapsed*(8+i%4))%W,y=(i*79)%H,r=(i%4)+.5;ctx.fillStyle=i%7===0?w.accent:'#fff';ctx.fillRect(x,y,r,r);}ctx.globalAlpha=.12;ctx.strokeStyle=w.accent;ctx.lineWidth=1;for(let i=0;i<8;i++){ctx.beginPath();ctx.arc(W/2,H*.55,100+i*85+Math.sin(game.elapsed+i)*8,0,Math.PI*2);ctx.stroke();}ctx.globalAlpha=1;}
function drawReactor(){const s=currentSkin(),x=W/2,y=H-58;ctx.save();ctx.shadowBlur=35;ctx.shadowColor=s.c1;const g=ctx.createRadialGradient(x-8,y-10,4,x,y,48);g.addColorStop(0,'#fff');g.addColorStop(.18,s.c1);g.addColorStop(.62,s.c2);g.addColorStop(1,'#02040b');ctx.fillStyle=g;ctx.beginPath();ctx.arc(x,y,42,0,Math.PI*2);ctx.fill();ctx.strokeStyle=s.c1;ctx.lineWidth=3;ctx.beginPath();ctx.arc(x,y,52+Math.sin(game.elapsed*3)*3,0,Math.PI*2);ctx.stroke();ctx.restore();}
function drawOrb(o,w){const color=o.type==='bomb'?'#ff3f61':o.type==='shard'?'#69ffb5':o.type==='armored'?'#61a5ff':o.type==='rival'?currentSkin(o.skin).c1:o.type==='splitter'?'#ffe05f':w.enemy;ctx.save();ctx.translate(o.x,o.y);ctx.rotate(o.phase*.15);ctx.shadowBlur=25;ctx.shadowColor=color;const g=ctx.createRadialGradient(-o.r*.3,-o.r*.35,2,0,0,o.r);g.addColorStop(0,'#fff');g.addColorStop(.15,color);g.addColorStop(.55,o.type==='rival'?currentSkin(o.skin).c2:'#32115d');g.addColorStop(1,'#03040d');ctx.fillStyle=g;ctx.beginPath();ctx.arc(0,0,o.r,0,Math.PI*2);ctx.fill();ctx.strokeStyle=color;ctx.lineWidth=o.type==='armored'||o.type==='rival'?4:2;ctx.beginPath();ctx.arc(0,0,o.r+5+Math.sin(o.phase)*3,0,Math.PI*2);ctx.stroke();for(let i=0;i<(o.type==='rival'?o.tier:3);i++){ctx.rotate(Math.PI*2/(o.type==='rival'?o.tier:3));ctx.fillStyle=color;ctx.fillRect(o.r+7,-2,9,4);}ctx.restore();}
function drawProjectile(p){ctx.save();ctx.shadowBlur=22;ctx.shadowColor=p.color;ctx.fillStyle=p.color;ctx.beginPath();ctx.arc(p.x,p.y,p.r,0,Math.PI*2);ctx.fill();ctx.strokeStyle='#fff';ctx.beginPath();ctx.arc(p.x,p.y,p.r+5,0,Math.PI*2);ctx.stroke();ctx.restore();}
function drawBoss(b,w){ctx.save();ctx.translate(b.x,b.y);ctx.shadowBlur=55;ctx.shadowColor=w.accent;ctx.strokeStyle=w.accent;ctx.lineWidth=5;for(let i=0;i<3;i++){ctx.rotate(b.t*.003*(i%2?1:-1));ctx.beginPath();ctx.arc(0,0,b.r-i*18,0,Math.PI*2);ctx.stroke();}const g=ctx.createRadialGradient(-20,-25,5,0,0,b.r*.75);g.addColorStop(0,'#fff');g.addColorStop(.15,w.accent);g.addColorStop(.5,w.enemy);g.addColorStop(1,'#02020b');ctx.fillStyle=g;ctx.beginPath();ctx.arc(0,0,b.r*.68,0,Math.PI*2);ctx.fill();for(const weak of b.weak){if(!weak.alive)continue;const x=Math.cos(weak.a+b.t*.6)*(b.r+36),y=Math.sin(weak.a+b.t*.6)*(b.r*.65+28);ctx.fillStyle='#fff';ctx.shadowBlur=25;ctx.shadowColor='#ffe66d';ctx.beginPath();ctx.arc(x,y,15,0,Math.PI*2);ctx.fill();ctx.strokeStyle='#ffdc54';ctx.beginPath();ctx.arc(x,y,23,0,Math.PI*2);ctx.stroke();}ctx.restore();}
function frame(ts){const dt=Math.min(.033,(ts-last)/1000||0);last=ts;update(dt);draw();raf=requestAnimationFrame(frame);}raf=requestAnimationFrame(frame);
function finish(victory=false,duelData=null){if(!game.running)return;game.running=false;hideGame();save.best=Math.max(save.best,game.score);const gain=Math.max(3,Math.floor(game.score/5000)+game.shardsEarned);save.shards+=gain;save.xp+=Math.floor(game.score/100);while(save.xp>350+save.level*140){save.xp-=350+save.level*140;save.level++;}persist();game.lastResult={score:Math.floor(game.score),wave:game.wave,perfects:game.perfects,maxCombo:game.maxCombo,stage:worlds[game.world].name,seed:game.seed};$('finalScore').textContent=format(game.score);$('resultWave').textContent=game.wave;$('resultPerfect').textContent=game.perfects;$('resultCombo').textContent='x'+game.maxCombo;$('resultShards').textContent='+'+gain;$('resultTitle').textContent=victory?'VICTORY SIGNAL':'RUN COMPLETE';$('duelResult').classList.toggle('hidden',!duelData);$('rematchBtn').classList.toggle('hidden',!duelData);if(duelData)$('duelResult').textContent=duelData;showScreen('resultScreen');audio.sfx(victory?'bossDown':'damage');updateMenu();}
const audio={ctx:null,master:null,music:null,sfxGain:null,compressor:null,delay:null,delayGain:null,nextBeat:0,step:0,start(){if(this.ctx){this.ctx.resume?.();return;}this.ctx=new(window.AudioContext||window.webkitAudioContext)();this.master=this.ctx.createGain();this.music=this.ctx.createGain();this.sfxGain=this.ctx.createGain();this.compressor=this.ctx.createDynamicsCompressor();this.compressor.threshold.value=-18;this.compressor.knee.value=18;this.compressor.ratio.value=5;this.compressor.attack.value=.004;this.compressor.release.value=.18;this.delay=this.ctx.createDelay(.8);this.delay.delayTime.value=.19;this.delayGain=this.ctx.createGain();this.delayGain.gain.value=.16;this.delay.connect(this.delayGain);this.delayGain.connect(this.compressor);this.master.gain.value=.78;this.music.gain.value=save.music/100*.34;this.sfxGain.gain.value=save.sfx/100*.56;this.music.connect(this.compressor);this.sfxGain.connect(this.compressor);this.compressor.connect(this.master);this.master.connect(this.ctx.destination);},tone(freq,dur=.1,type='sine',gain=.1,target=this.sfxGain,when=0,slide=1){if(!this.ctx)return;const t=this.ctx.currentTime+when,o=this.ctx.createOscillator(),g=this.ctx.createGain(),f=this.ctx.createBiquadFilter();o.type=type;o.frequency.setValueAtTime(Math.max(20,freq),t);o.frequency.exponentialRampToValueAtTime(Math.max(20,freq*slide),t+dur);f.type='lowpass';f.frequency.setValueAtTime(Math.min(9000,freq*8+800),t);f.frequency.exponentialRampToValueAtTime(Math.max(250,freq*2),t+dur);g.gain.setValueAtTime(.0001,t);g.gain.exponentialRampToValueAtTime(Math.max(.0002,gain),t+.006);g.gain.exponentialRampToValueAtTime(.0001,t+dur);o.connect(f);f.connect(g);g.connect(target);if(target===this.music)g.connect(this.delay);o.start(t);o.stop(t+dur+.03);},noise(dur=.16,gain=.12,cut=1800,target=this.sfxGain){if(!this.ctx)return;const len=Math.floor(this.ctx.sampleRate*dur),buf=this.ctx.createBuffer(1,len,this.ctx.sampleRate),d=buf.getChannelData(0);for(let i=0;i<len;i++)d[i]=(Math.random()*2-1)*Math.pow(1-i/len,1.6);const s=this.ctx.createBufferSource(),g=this.ctx.createGain(),f=this.ctx.createBiquadFilter();f.type='bandpass';f.frequency.value=cut;f.Q.value=.8;s.buffer=buf;g.gain.setValueAtTime(gain,this.ctx.currentTime);g.gain.exponentialRampToValueAtTime(.0001,this.ctx.currentTime+dur);s.connect(f);f.connect(g);g.connect(target);s.start();},kick(when=0,gain=.16){this.tone(120,.16,'sine',gain,this.music,when,.28);},sfx(name){if(!this.ctx)return;const now=this.ctx.currentTime;switch(name){case'hit':this.tone(310,.07,'triangle',.12,this.sfxGain,0,.72);this.noise(.035,.045,3200);break;case'perfect':this.tone(740,.13,'sine',.14,this.sfxGain,0,1.42);this.tone(1110,.22,'triangle',.09,this.sfxGain,.045,1.18);break;case'armor':this.tone(155,.14,'square',.11,this.sfxGain,0,.55);this.noise(.08,.07,900);break;case'damage':this.tone(92,.42,'sawtooth',.18,this.sfxGain,0,.34);this.noise(.38,.18,520);break;case'shield':this.tone(420,.28,'sine',.12,this.sfxGain,0,2.1);this.tone(840,.18,'triangle',.07,this.sfxGain,.06,1.2);break;case'volley':this.tone(175,.3,'sawtooth',.14,this.sfxGain,0,2.8);this.noise(.12,.09,1500);break;case'defuse':this.tone(520,.22,'triangle',.11,this.sfxGain,0,1.8);this.tone(1040,.3,'sine',.07,this.sfxGain,.04,.82);break;case'boss':this.tone(48,.95,'sawtooth',.2,this.sfxGain,0,.7);this.noise(.9,.16,260);break;case'bossDown':this.tone(75,1.2,'sawtooth',.22,this.sfxGain,0,.25);this.noise(1.1,.2,500);for(let i=0;i<4;i++)this.tone(220*Math.pow(1.25,i),.3,'triangle',.07,this.sfxGain,.12*i,1.3);break;case'overdrive':this.tone(180,.52,'sawtooth',.15,this.sfxGain,0,4.2);this.tone(720,.55,'triangle',.08,this.sfxGain,.08,1.5);break;case'blast':this.tone(52,.95,'sawtooth',.22,this.sfxGain,0,.22);this.noise(.8,.21,420);break;case'warning':this.tone(260,.16,'square',.1);this.tone(195,.18,'square',.1,this.sfxGain,.18);break;default:this.tone(260,.08,'triangle',.1);}return now;},update(g){if(!this.ctx||!g.running)return;this.music.gain.setTargetAtTime(save.music/100*.34,this.ctx.currentTime,.12);this.sfxGain.gain.setTargetAtTime(save.sfx/100*.56,this.ctx.currentTime,.12);if(this.ctx.currentTime<this.nextBeat)return;const intensity=Math.min(1,(g.wave-1)/12+(g.combo>12?.18:0)+(g.boss?.3:0)+(g.overdriveTime>0?.28:0)),bpm=118+g.world*3+Math.round(intensity*28),beat=60/bpm/2,scales=[[110,130.81,164.81,196],[98,116.54,146.83,174.61],[123.47,146.83,185,220],[82.41,103.83,123.47,155.56],[110,138.59,164.81,207.65],[123.47,155.56,196,246.94]],scale=scales[g.world%scales.length],root=scale[this.step%scale.length],bar=this.step%8;if(bar===0||bar===4)this.kick(0,.12+intensity*.05);if(bar===2||bar===6)this.noise(.045,.028+intensity*.02,5200,this.music);this.tone(root/2,beat*.82,'sawtooth',.026+intensity*.02,this.music,0,bar===7?1.5:1);if(bar%2===0)this.tone(root,beat*.48,'triangle',.025+intensity*.015,this.music,.012,bar===6?1.25:1);if(g.boss||g.overdriveTime>0)this.tone(root*2,beat*.32,'square',.012+intensity*.012,this.music,.02,1.08);this.step++;this.nextBeat=this.ctx.currentTime+beat;}};
function bind(id,fn){$(id).addEventListener('click',fn);}