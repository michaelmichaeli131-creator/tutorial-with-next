function draw(){const w=worlds[game.world%worlds.length];const g=ctx.createRadialGradient(W*.5,H*.18,10,W*.5,H*.55,Math.max(W,H));g.addColorStop(0,w.bg[1]);g.addColorStop(.48,w.bg[0]);g.addColorStop(1,'#010207');ctx.fillStyle=g;ctx.fillRect(0,0,W,H);ctx.save();if(game.shake&&save.shake&&!reduceMotion)ctx.translate((rng()-.5)*game.shake,(rng()-.5)*game.shake);drawBackground(w);drawReactor();for(const o of game.orbs)drawOrb(o,w);for(const p of game.projectiles)drawProjectile(p);if(game.boss)drawBoss(game.boss,w);ctx.globalCompositeOperation='lighter';for(const r of game.rings){ctx.globalAlpha=r.life/r.max;ctx.strokeStyle=r.color;ctx.lineWidth=Math.max(1,3*(r.life/r.max));ctx.beginPath();ctx.arc(r.x,r.y,r.r,0,Math.PI*2);ctx.stroke();}for(const p of game.particles){ctx.globalAlpha=Math.max(0,p.life/p.max);ctx.fillStyle=p.color;ctx.beginPath();ctx.arc(p.x,p.y,p.r,0,Math.PI*2);ctx.fill();}ctx.globalCompositeOperation='source-over';for(const t of game.texts){ctx.globalAlpha=t.life/t.max;ctx.fillStyle=t.color;ctx.font=`900 ${isMobile?16:18}px system-ui`;ctx.textAlign='center';ctx.shadowBlur=12;ctx.shadowColor=t.color;ctx.fillText(t.text,t.x,t.y);}ctx.restore();ctx.globalAlpha=1;ctx.shadowBlur=0;if(game.flash>0){ctx.fillStyle=`rgba(255,255,255,${Math.min(.42,game.flash)})`;ctx.fillRect(0,0,W,H);game.flash*=.82;}}
function drawBackground(w){const t=game.elapsed;ctx.save();const neb=ctx.createRadialGradient(W*.2+Math.sin(t*.08)*W*.08,H*.25,0,W*.2,H*.25,Math.max(W,H)*.7);neb.addColorStop(0,w.accent+'24');neb.addColorStop(.5,w.enemy+'12');neb.addColorStop(1,'transparent');ctx.fillStyle=neb;ctx.fillRect(0,0,W,H);ctx.globalCompositeOperation='lighter';for(let i=0;i<quality.stars;i++){const depth=1+(i%3),x=(i*137+t*(4+depth*6))%W,y=(i*79+(i%5)*31)%H,r=.45+depth*.42,tw=.45+.55*Math.sin(t*(1+depth*.2)+i);ctx.globalAlpha=.18+tw*.5;ctx.fillStyle=i%9===0?w.accent:'#fff';ctx.fillRect(x,y,r,r);}ctx.globalAlpha=.09;ctx.strokeStyle=w.accent;ctx.lineWidth=1;for(let i=0;i<(isMobile?5:8);i++){ctx.beginPath();ctx.arc(W/2,H*.57,80+i*(isMobile?78:92)+Math.sin(t*.5+i)*7,0,Math.PI*2);ctx.stroke();}ctx.restore();ctx.globalAlpha=1;}
function drawReactor(){const s=currentSkin(),x=W/2,y=H-(isMobile?92:58),pulse=1+Math.sin(game.elapsed*4)*.045;ctx.save();ctx.translate(x,y);ctx.scale(pulse,pulse);ctx.globalCompositeOperation='lighter';ctx.shadowBlur=quality.glow*1.8;ctx.shadowColor=s.c1;const halo=ctx.createRadialGradient(0,0,2,0,0,70);halo.addColorStop(0,'#ffffff');halo.addColorStop(.12,s.c1);halo.addColorStop(.45,s.c2+'bb');halo.addColorStop(1,'transparent');ctx.fillStyle=halo;ctx.beginPath();ctx.arc(0,0,70,0,Math.PI*2);ctx.fill();ctx.globalCompositeOperation='source-over';const core=ctx.createRadialGradient(-9,-12,3,0,0,45);core.addColorStop(0,'#fff');core.addColorStop(.16,s.c1);core.addColorStop(.58,s.c2);core.addColorStop(1,'#02040b');ctx.fillStyle=core;ctx.beginPath();ctx.arc(0,0,isMobile?38:42,0,Math.PI*2);ctx.fill();ctx.strokeStyle=s.c1;ctx.lineWidth=2.5;for(let i=0;i<2;i++){ctx.save();ctx.rotate(game.elapsed*(i?-.7:.9));ctx.setLineDash([12,9]);ctx.beginPath();ctx.arc(0,0,50+i*10,0,Math.PI*2);ctx.stroke();ctx.restore();}ctx.restore();}
function drawOrb(o,w){const color=o.type==='bomb'?'#ff3f61':o.type==='shard'?'#69ffb5':o.type==='armored'?'#61a5ff':o.type==='rival'?currentSkin(o.skin).c1:o.type==='splitter'?'#ffe05f':w.enemy;ctx.save();ctx.translate(o.x,o.y);ctx.rotate(o.phase*.15);ctx.shadowBlur=quality.glow;ctx.shadowColor=color;ctx.globalCompositeOperation='lighter';ctx.fillStyle=color+'20';ctx.beginPath();ctx.arc(0,0,o.r*1.55,0,Math.PI*2);ctx.fill();ctx.globalCompositeOperation='source-over';const g=ctx.createRadialGradient(-o.r*.34,-o.r*.38,1,0,0,o.r);g.addColorStop(0,'#fff');g.addColorStop(.13,color);g.addColorStop(.55,o.type==='rival'?currentSkin(o.skin).c2:'#32115d');g.addColorStop(1,'#03040d');ctx.fillStyle=g;ctx.beginPath();ctx.arc(0,0,o.r,0,Math.PI*2);ctx.fill();ctx.strokeStyle=color;ctx.lineWidth=o.type==='armored'||o.type==='rival'?4:2;ctx.beginPath();ctx.arc(0,0,o.r+5+Math.sin(o.phase)*3,0,Math.PI*2);ctx.stroke();ctx.globalAlpha=.82;for(let i=0;i<(o.type==='rival'?Math.max(3,o.tier):3);i++){ctx.rotate(Math.PI*2/(o.type==='rival'?Math.max(3,o.tier):3));ctx.fillStyle=color;ctx.beginPath();ctx.moveTo(o.r+5,-4);ctx.lineTo(o.r+16,0);ctx.lineTo(o.r+5,4);ctx.fill();}ctx.restore();}
function drawProjectile(p){ctx.save();ctx.globalCompositeOperation='lighter';const g=ctx.createRadialGradient(p.x,p.y,1,p.x,p.y,p.r*2.4);g.addColorStop(0,'#fff');g.addColorStop(.22,p.color);g.addColorStop(1,'transparent');ctx.fillStyle=g;ctx.beginPath();ctx.arc(p.x,p.y,p.r*2.4,0,Math.PI*2);ctx.fill();ctx.strokeStyle='#fff';ctx.lineWidth=1.5;ctx.beginPath();ctx.arc(p.x,p.y,p.r+5,0,Math.PI*2);ctx.stroke();ctx.restore();}
function drawBoss(b,w){ctx.save();ctx.translate(b.x,b.y);ctx.globalCompositeOperation='lighter';ctx.shadowBlur=quality.glow*2;ctx.shadowColor=w.accent;for(let i=0;i<3;i++){ctx.save();ctx.rotate(b.t*(i%2?-.16:.12)+i);ctx.strokeStyle=i===1?w.enemy:w.accent;ctx.lineWidth=4-i;ctx.setLineDash([18+i*4,10]);ctx.beginPath();ctx.arc(0,0,b.r-i*17,0,Math.PI*2);ctx.stroke();ctx.restore();}ctx.globalCompositeOperation='source-over';const g=ctx.createRadialGradient(-20,-25,5,0,0,b.r*.78);g.addColorStop(0,'#fff');g.addColorStop(.14,w.accent);g.addColorStop(.48,w.enemy);g.addColorStop(1,'#02020b');ctx.fillStyle=g;ctx.beginPath();ctx.arc(0,0,b.r*.68,0,Math.PI*2);ctx.fill();ctx.strokeStyle='#ffffff66';ctx.lineWidth=2;ctx.stroke();for(const weak of b.weak){if(!weak.alive)continue;const x=Math.cos(weak.a+b.t*.6)*(b.r+36),y=Math.sin(weak.a+b.t*.6)*(b.r*.65+28);ctx.save();ctx.translate(x,y);ctx.globalCompositeOperation='lighter';ctx.shadowBlur=28;ctx.shadowColor='#ffe66d';ctx.fillStyle='#fff';ctx.beginPath();ctx.arc(0,0,isMobile?17:15,0,Math.PI*2);ctx.fill();ctx.strokeStyle='#ffdc54';ctx.lineWidth=3;ctx.beginPath();ctx.arc(0,0,isMobile?27:23,0,Math.PI*2);ctx.stroke();ctx.restore();}ctx.restore();}
function frame(ts){const dt=Math.min(.033,(ts-last)/1000||0);last=ts;update(dt);draw();raf=requestAnimationFrame(frame);}raf=requestAnimationFrame(frame);
function finish(victory=false,duelData=null){if(!game.running)return;game.running=false;hideGame();save.best=Math.max(save.best,game.score);const gain=Math.max(3,Math.floor(game.score/5000)+game.shardsEarned);save.shards+=gain;save.xp+=Math.floor(game.score/100);while(save.xp>350+save.level*140){save.xp-=350+save.level*140;save.level++;}persist();game.lastResult={score:Math.floor(game.score),wave:game.wave,perfects:game.perfects,maxCombo:game.maxCombo,stage:worlds[game.world].name,seed:game.seed};$('finalScore').textContent=format(game.score);$('resultWave').textContent=game.wave;$('resultPerfect').textContent=game.perfects;$('resultCombo').textContent='x'+game.maxCombo;$('resultShards').textContent='+'+gain;$('resultTitle').textContent=victory?'VICTORY SIGNAL':'RUN COMPLETE';$('duelResult').classList.toggle('hidden',!duelData);$('rematchBtn').classList.toggle('hidden',!duelData);if(duelData)$('duelResult').textContent=duelData;showScreen('resultScreen');audio.sfx(victory?'bossDown':'damage');haptic(victory?[30,25,60]:25);updateMenu();}
const audio={ctx:null,master:null,music:null,sfxGain:null,compressor:null,musicFilter:null,delay:null,delayGain:null,reverb:null,reverbGain:null,nextBeat:0,step:0,start(){if(this.ctx){this.ctx.resume?.();return;}this.ctx=new(window.AudioContext||window.webkitAudioContext)({latencyHint:'interactive'});this.master=this.ctx.createGain();this.music=this.ctx.createGain();this.sfxGain=this.ctx.createGain();this.compressor=this.ctx.createDynamicsCompressor();this.musicFilter=this.ctx.createBiquadFilter();this.delay=this.ctx.createDelay(.7);this.delayGain=this.ctx.createGain();this.reverb=this.ctx.createConvolver();this.reverbGain=this.ctx.createGain();this.compressor.threshold.value=-16;this.compressor.knee.value=20;this.compressor.ratio.value=5;this.compressor.attack.value=.003;this.compressor.release.value=.22;this.musicFilter.type='lowpass';this.musicFilter.frequency.value=7200;this.delay.delayTime.value=.18;this.delayGain.gain.value=.13;this.reverb.buffer=this.impulse(.65,2.2);this.reverbGain.gain.value=.1;this.master.gain.value=.78;this.music.gain.value=save.music/100*.34;this.sfxGain.gain.value=save.sfx/100*.58;this.music.connect(this.musicFilter);this.musicFilter.connect(this.compressor);this.music.connect(this.delay);this.delay.connect(this.delayGain);this.delayGain.connect(this.compressor);this.sfxGain.connect(this.compressor);this.sfxGain.connect(this.reverb);this.reverb.connect(this.reverbGain);this.reverbGain.connect(this.compressor);this.compressor.connect(this.master);this.master.connect(this.ctx.destination);},impulse(seconds,decay){const len=Math.max(1,Math.floor(this.ctx.sampleRate*seconds)),buf=this.ctx.createBuffer(2,len,this.ctx.sampleRate);for(let c=0;c<2;c++){const d=buf.getChannelData(c);for(let i=0;i<len;i++)d[i]=(Math.random()*2-1)*Math.pow(1-i/len,decay);}return buf;},tone(freq,dur=.1,type='sine',gain=.1,target=this.sfxGain,when=0,slide=1,pan=0){if(!this.ctx)return;const t=this.ctx.currentTime+when,o=this.ctx.createOscillator(),g=this.ctx.createGain(),f=this.ctx.createBiquadFilter(),p=this.ctx.createStereoPanner?this.ctx.createStereoPanner():null;o.type=type;o.frequency.setValueAtTime(Math.max(20,freq),t);o.frequency.exponentialRampToValueAtTime(Math.max(20,freq*slide),t+dur);f.type='lowpass';f.frequency.setValueAtTime(Math.min(11000,freq*9+900),t);f.frequency.exponentialRampToValueAtTime(Math.max(260,freq*2.1),t+dur);g.gain.setValueAtTime(.0001,t);g.gain.exponentialRampToValueAtTime(Math.max(.0002,gain),t+.005);g.gain.exponentialRampToValueAtTime(.0001,t+dur);o.connect(f);f.connect(g);if(p){p.pan.value=Math.max(-1,Math.min(1,pan));g.connect(p);p.connect(target);}else g.connect(target);o.start(t);o.stop(t+dur+.03);},noise(dur=.16,gain=.12,cut=1800,target=this.sfxGain,pan=0){if(!this.ctx)return;const len=Math.floor(this.ctx.sampleRate*dur),buf=this.ctx.createBuffer(1,len,this.ctx.sampleRate),d=buf.getChannelData(0);for(let i=0;i<len;i++)d[i]=(Math.random()*2-1)*Math.pow(1-i/len,1.7);const s=this.ctx.createBufferSource(),g=this.ctx.createGain(),f=this.ctx.createBiquadFilter(),p=this.ctx.createStereoPanner?this.ctx.createStereoPanner():null;f.type='bandpass';f.frequency.value=cut;f.Q.value=.75;s.buffer=buf;g.gain.setValueAtTime(gain,this.ctx.currentTime);g.gain.exponentialRampToValueAtTime(.0001,this.ctx.currentTime+dur);s.connect(f);f.connect(g);if(p){p.pan.value=pan;g.connect(p);p.connect(target);}else g.connect(target);s.start();},kick(when=0,gain=.17){this.tone(128,.18,'sine',gain,this.music,when,.22);},sfx(name){if(!this.ctx)return;switch(name){case'hit':this.tone(340,.065,'triangle',.115,this.sfxGain,0,.66,(Math.random()-.5)*.5);this.noise(.03,.04,3600);break;case'perfect':this.tone(760,.14,'sine',.15,this.sfxGain,0,1.5);this.tone(1140,.24,'triangle',.095,this.sfxGain,.04,1.2,.25);this.tone(1520,.18,'sine',.05,this.sfxGain,.085,.92,-.25);haptic(10);break;case'armor':this.tone(145,.15,'square',.11,this.sfxGain,0,.5);this.noise(.08,.065,850);haptic(14);break;case'damage':this.tone(88,.46,'sawtooth',.2,this.sfxGain,0,.3);this.noise(.4,.19,480);haptic([25,20,35]);break;case'shield':this.tone(420,.3,'sine',.12,this.sfxGain,0,2.2);this.tone(840,.2,'triangle',.07,this.sfxGain,.05,1.25);break;case'volley':this.tone(160,.34,'sawtooth',.15,this.sfxGain,0,3.1);this.noise(.13,.085,1550);break;case'defuse':this.tone(520,.23,'triangle',.12,this.sfxGain,0,1.85);this.tone(1040,.32,'sine',.075,this.sfxGain,.035,.8);haptic(12);break;case'boss':this.tone(46,1.05,'sawtooth',.21,this.sfxGain,0,.64);this.noise(.95,.16,250);break;case'bossDown':this.tone(72,1.25,'sawtooth',.23,this.sfxGain,0,.22);this.noise(1.15,.2,480);for(let i=0;i<5;i++)this.tone(220*Math.pow(1.22,i),.32,'triangle',.075,this.sfxGain,.11*i,1.34,(i-2)*.18);break;case'overdrive':this.tone(170,.55,'sawtooth',.16,this.sfxGain,0,4.4);this.tone(720,.6,'triangle',.09,this.sfxGain,.07,1.55);break;case'blast':this.tone(48,1,'sawtooth',.23,this.sfxGain,0,.2);this.noise(.85,.22,400);haptic([20,15,50]);break;case'warning':this.tone(260,.15,'square',.1);this.tone(190,.2,'square',.1,this.sfxGain,.17);break;default:this.tone(260,.08,'triangle',.1);}},update(g){if(!this.ctx||!g.running)return;this.music.gain.setTargetAtTime(save.music/100*.34,this.ctx.currentTime,.12);this.sfxGain.gain.setTargetAtTime(save.sfx/100*.58,this.ctx.currentTime,.12);const intensity=Math.min(1,(g.wave-1)/12+(g.combo>12?.18:0)+(g.boss?.3:0)+(g.overdriveTime>0?.28:0));this.musicFilter.frequency.setTargetAtTime(4200+intensity*5200,this.ctx.currentTime,.18);if(this.ctx.currentTime<this.nextBeat)return;const bpm=118+g.world*3+Math.round(intensity*30),beat=60/bpm/2,scales=[[110,130.81,164.81,196],[98,116.54,146.83,174.61],[123.47,146.83,185,220],[82.41,103.83,123.47,155.56],[110,138.59,164.81,207.65],[123.47,155.56,196,246.94]],scale=scales[g.world%scales.length],root=scale[this.step%scale.length],bar=this.step%8;if(bar===0||bar===4)this.kick(0,.12+intensity*.06);if(bar===2||bar===6)this.noise(.045,.026+intensity*.025,5600,this.music,bar===2?-.35:.35);this.tone(root/2,beat*.84,'sawtooth',.025+intensity*.021,this.music,0,bar===7?1.5:1);if(bar%2===0)this.tone(root,beat*.5,'triangle',.024+intensity*.016,this.music,.012,bar===6?1.25:1,bar===2?-.25:.25);if(g.boss||g.overdriveTime>0)this.tone(root*2,beat*.34,'square',.012+intensity*.013,this.music,.02,1.08);this.step++;this.nextBeat=this.ctx.currentTime+beat;}};
function bind(id,fn){$(id).addEventListener('click',fn);}
