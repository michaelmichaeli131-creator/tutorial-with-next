/* V24 THE RUN LAYER — give the wave a rule and the build a shape.

   V21 to V23 fixed the second-to-second game: a price for being wrong, a priority between
   hostiles, and a cost for spending an ability early. What none of them touched is the layer
   above that, the one that decides whether a run is worth starting again — and measured, that
   layer was doing nothing at all.

   Two findings, both from the same harness the earlier layers were tuned on.

   1. The four wave directives were labels. `checkWave` advances on `waveKills >= waveTarget` and
      nothing else reads `game.objective`, so PERFECT HUNT, CHAIN REACTION and NO DAMAGE were the
      same wave as PURGE with a different word printed on the HUD. A bot that deliberately let
      hostiles through during a NO DAMAGE wave completed it, banked the full bonus and never once
      saw the directive fail — because there was no code that could fail it.

   2. The augment choice was a non-choice. Six flat multipliers, three offered, nothing
      interacting with anything. Two bots differing only in which card they installed — one
      always taking the strongest looking card, one always taking the weakest — finished within
      noise of each other. A choice screen that pauses the game three times a run and does not
      move the outcome is worse than no choice screen: it teaches the player that the decision is
      cosmetic.

   So: directives that direct, and augments that build.

   **Directives.** Each non-boss wave now carries a rule the player has to actively satisfy —
   PERFECT HUNT wants centre hits, CHAIN REACTION wants kills arriving in bursts, NO BREACH wants
   nothing at all to reach the reactor, runners included. Meeting one raises a streak multiplier
   and pays a commendation; missing one drops the streak to zero. Crucially the *wave* still
   advances on kills exactly as before. Gating wave progress on the directive would let a player
   who cannot land perfects stall in wave five for ever, which is the failure mode V21 avoided by
   clamping the arrival interval rather than scaling it: a rule that can only add pressure is
   safe, a rule that can remove progress is not.

   NO BREACH is the one that changes targeting rather than aim. V22 made a shard runner something
   you are allowed to give up; for one wave in four it is not, so the same hostile is worth
   ignoring on Tuesday and worth dropping everything for on Wednesday. A threat whose value
   depends on the wave is the cheapest variety in the game.

   **Augments.** Twelve cards in three families, each one either conditional on a system V21-V23
   built, or carrying a downside, or both — and two cards from the same family unlock a resonance
   that changes a rule rather than a number. Offers are built so that one card continues the
   family you have started and one card comes from somewhere else, which is what makes the pick a
   decision every time instead of a decision when the shuffle happens to be interesting.
   Commendations earned from directives elevate one card in an offer, and the elevated card is
   deliberately drawn from *outside* your lead family: the reward for playing the wave well is a
   temptation to break your build, not a free upgrade to it.

   Duel scope. Directives are rules about the player's own play and about what happens when a
   hostile lands — the V22 pattern, identical on both clients and needing no synchronisation.
   Nothing here spawns, removes or reroutes a hostile, so the schedule V20 made authoritative is
   untouched. Augments already existed in duels and are already asymmetric by pilot and weapon;
   these change the same class of thing, the player's own stats and their own reactor's rules.
   Campaign is deliberately excluded: V14 stages carry real objectives of their own that the
   campaign layer already tracks, and two objective systems on one HUD would only confuse. */

const V24_STREAK={step:.15,cap:4};
const V24_ELEVATED=1.6;      /* how much a commendation is worth on a card's numbers */
const V24_COMMEND=2;         /* commendations spent to elevate one card */
const V24_CHAIN_WINDOW=1.25; /* seconds between kills that still counts as one burst */

/* ---- Directives ---------------------------------------------------------------------------
   Indexed on wave%4, which is the cadence the base already uses: every fourth wave spawns a
   titan, and a directive during a boss fight would be dead anyway because `checkWave` returns
   early while a boss is alive. So the rotation reads precision, tempo, defence, titan. */

const V24_DIRECTIVES=[
 {id:'titan',name:'TITAN',brief:'BREAK THE TITAN'},
 {id:'perfect',name:'PERFECT HUNT',brief:'LAND CENTRE HITS',
  /* A quarter of the wave, floored at four. Tied to waveTarget rather than a flat number so it
     stays the same *share* of the wave as targets grow, and floored so wave one is not free. */
  need:()=>Math.max(4,Math.round(game.waveTarget*.25)),
  short:(d)=>`◎ ${d.progress}/${d.need}`},
 {id:'chain',name:'CHAIN REACTION',brief:'KILL IN BURSTS',
  need:()=>Math.min(9,5+Math.floor(game.wave/5)),
  short:(d)=>`⛓ ${d.best}/${d.need}`},
 {id:'breach',name:'NO BREACH',brief:'NOTHING GETS THROUGH',
  need:()=>0,
  short:(d)=>d.failed?'✕ BREACHED':'✓ SEALED'}
];

function v24Directive(){return game.v24?game.v24.dir:null;}

/* Solo, gauntlet and duel run the endless wave ladder; campaign stages own their own objective
   and their own progress bar, so they are left exactly as they were. */
function v24Live(){return game.running&&game.mode!=='campaign';}

function v24StartDirective(){
 if(!game.v24)return;
 const template=game.mode==='gauntlet'?V24_DIRECTIVES[0]:V24_DIRECTIVES[game.wave%4];
 const dir={id:template.id,name:template.name,brief:template.brief,need:template.need?template.need():0,
  progress:0,best:0,run:0,lastKill:-99,failed:false,met:false,resolved:false,short:template.short};
 game.v24.dir=dir;
 if(game.mode!=='campaign'){
  game.objective=dir.name;
  if(dir.id!=='titan')toast(`${dir.name} • ${dir.brief}`);
 }
}

function v24DirectiveMet(dir){
 if(!dir||dir.id==='titan')return false;
 if(dir.id==='breach')return !dir.failed;
 if(dir.id==='chain')return dir.best>=dir.need;
 return dir.progress>=dir.need;
}

/* Called the moment the kill quota is filled, before the base schedules the next wave. The
   payout is deliberately split: a lump of score for the moment, a streak multiplier that has to
   be defended, and a commendation that only cashes out at the next augment screen. One-off score
   alone cannot carry this — at wave eight a flat five thousand is under two seconds of ordinary
   scoring, which is exactly why the old directive bonus went unnoticed. */
function v24ResolveDirective(){
 const dir=v24Directive();
 if(!dir||dir.resolved)return;
 dir.resolved=true;
 if(dir.id==='titan')return;
 dir.met=v24DirectiveMet(dir);
 if(dir.met){
  game.v24.streak=Math.min(V24_STREAK.cap,game.v24.streak+1);
  game.v24.cred++;
  game.v24.met++;
  score(Math.round(2600+game.wave*700),'objective');
  /* A cleared directive also clears the reactor. The reward has to be felt in the next ten
     seconds of play, not only in the score column. */
  game.v21Heat=0;
  floating(W*.5,H*.46,`DIRECTIVE MET  x${(1+game.v24.streak*V24_STREAK.step).toFixed(2)}`,'#ffe15c');
  toast(`${dir.name} CLEARED • STREAK ${game.v24.streak}`);
  audio.sfx('defuse');
  haptic([14,18,14]);
 }else{
  if(game.v24.streak>0)toast(`${dir.name} FAILED • STREAK LOST`);
  game.v24.streak=0;
  game.v24.missed++;
 }
}

/* ---- Augments -------------------------------------------------------------------------------
   Every card is written against a knob in `game.v24.mod` rather than reaching into the systems
   directly, so the hooks further down are the only place that knows how a modifier is applied
   and a new card cannot quietly change the shape of an existing hook. `k` is the elevation
   factor: 1 for an ordinary card, V24_ELEVATED for one bought with commendations. It scales the
   upside only — an elevated card is a stronger card, not a safer one. */

const V24_FAMILIES={
 flux:{name:'FLUX',color:'#61efff',resonance:'PERFECT taps punch straight through a raised ward.'},
 volt:{name:'VOLT',color:'#ffb02e',resonance:'A discharge that catches six or more refunds 30% of its charge.'},
 salvage:{name:'SALVAGE',color:'#7dffb0',resonance:'The first breach of each wave is caught by the salvage net.'}
};

const V24_AUGMENTS=[
 /* FLUX — the reactor and the aim. Rewards a player who wants to fire faster by missing less. */
 {id:'coolant',family:'flux',name:'COOLANT LATTICE',
  desc:(k)=>`Reactor vents ${Math.round(40*k)}% faster. Overheat lockout lasts 30% longer.`,
  apply:(m,k)=>{m.decay*=1+.4*k;m.lockout*=1.3;}},
 {id:'focus',family:'flux',name:'FOCUS LENS',
  desc:(k)=>`PERFECT window +${Math.round(30*k)}%.`,
  apply:(m,k)=>{game.perfectWindow*=1+.3*k;}},
 {id:'flywheel',family:'flux',name:'INERTIAL FLYWHEEL',
  desc:(k)=>`PERFECT hits vent double heat and score +${Math.round(45*k)}%. Ordinary kills vent nothing.`,
  apply:(m,k)=>{m.perfectVent*=2;m.killVent=0;m.perfectScore+=.45*k;}},
 {id:'sync',family:'flux',name:'HARMONIC SYNC',
  desc:(k)=>`Ward cycles run ${Math.round(35*k)}% faster. A blocked tap costs no heat.`,
  apply:(m,k)=>{m.wardRate*=1+.35*k;m.blockFree=true;}},

 /* VOLT — the two ability buttons V23 turned into decisions, pushed further in both directions. */
 {id:'chain',family:'volt',name:'CHAIN REACTOR',
  desc:(k)=>`Chain radius +${Math.round(45*k)}%.`,
  apply:(m,k)=>{game.chainRadius*=1+.45*k;}},
 {id:'capacitor',family:'volt',name:'NOVA CAPACITOR',
  desc:(k)=>`Blast charges ${Math.round(35*k)}% faster.`,
  apply:(m,k)=>{game.blastGain*=1+.35*k;}},
 {id:'singularity',family:'volt',name:'SINGULARITY CELL',
  desc:(k)=>`Blast reach +${Math.round(40*k)}%. A discharge no longer cools the reactor.`,
  apply:(m,k)=>{m.blastReach*=1+.4*k;m.blastCools=false;}},
 {id:'furnace',family:'volt',name:'TIME FURNACE',
  desc:(k)=>`Overdrive lasts +${(3*k).toFixed(1)}s. Deferred heat is billed in full.`,
  apply:(m,k)=>{game.overdriveDuration+=3*k;m.odDebtFull=true;}},

 /* SALVAGE — greed. Every card here is worth more if you hold your nerve and less if you panic. */
 {id:'bounty',family:'salvage',name:'BOUNTY PROTOCOL',
  desc:()=>`Runners pay triple when killed and take double when they escape.`,
  apply:(m)=>{m.runnerKill=3;m.runnerSteal=2;}},
 {id:'nerve',family:'salvage',name:'HOLD YOUR NERVE',
  desc:(k)=>`Kills in the lower half of the arena score +${Math.round(55*k)}%.`,
  apply:(m,k)=>{m.lowScore+=.55*k;}},
 {id:'broadcast',family:'salvage',name:'GOLDEN SIGNAL',
  desc:(k)=>`All score +${Math.round(22*k)}%. The reactor vents 15% slower.`,
  apply:(m,k)=>{game.scoreMult*=1+.22*k;m.decay*=.85;}},
 {id:'shield',family:'salvage',name:'PHASE SHIELD',
  desc:(k)=>`Gain ${Math.round(k)} shield charge${Math.round(k)>1?'s':''}.`,
  apply:(m,k)=>{game.shields+=Math.round(k);}}
];

function v24DefaultMod(){
 return {decay:1,lockout:1,blockFree:false,wardRate:1,pierce:false,
  perfectVent:1,killVent:1,perfectScore:0,lowScore:0,
  blastReach:1,blastCools:true,blastRefund:0,odDebtFull:false,
  runnerKill:1,runnerSteal:1,net:0};
}

/* Reading through a helper rather than off `game` directly keeps every hook safe on the menu and
   during the first frames of a run, where `game.v24` does not exist yet. */
function v24Mod(){return game.v24?game.v24.mod:v24Default;}
const v24Default=v24DefaultMod();

function v24Resonance(){
 const mod=game.v24.mod;
 const counts={};
 for(const a of game.v24.augments)counts[a.family]=(counts[a.family]||0)+1;
 game.v24.counts=counts;
 /* Recomputed from scratch on every install instead of toggled on the second pick, because a
    resonance that is switched on once cannot be reasoned about after a restart or a save load. */
 mod.pierce=(counts.flux||0)>=2;
 mod.blastRefund=(counts.volt||0)>=2?.3:0;
 mod.net=(counts.salvage||0)>=2?1:0;
}

function v24Install(augment,elevated){
 const k=elevated?V24_ELEVATED:1;
 augment.apply(game.v24.mod,k);
 game.v24.augments.push({id:augment.id,family:augment.family,name:augment.name,elevated:!!elevated});
 const before=JSON.stringify([game.v24.mod.pierce,game.v24.mod.blastRefund,game.v24.mod.net]);
 v24Resonance();
 if(JSON.stringify([game.v24.mod.pierce,game.v24.mod.blastRefund,game.v24.mod.net])!==before){
  toast(`${V24_FAMILIES[augment.family].name} RESONANCE ONLINE`);
  audio.sfx('overdrive');
 }
}

const v24BeginBase=begin;
begin=function(mode='solo',seed){
 v24BeginBase(mode,seed);
 game.v24={mod:v24DefaultMod(),augments:[],counts:{},streak:0,cred:0,met:0,missed:0,dir:null,netUsed:false};
 v24StartDirective();
};

/* ---- Directive tracking ---------------------------------------------------------------------
   All three live directives are decided by things that already happen in `hitOrb` and at the
   reactor line, so tracking them is a matter of watching, not of adding rules to the update
   loop. Chain progress is a rolling burst rather than a total: killing six over a minute is not
   a chain reaction, and a directive that a slow player satisfies by accident teaches nothing. */

const v24HitBase=hitOrb;
hitOrb=function(o,x,y,chain=false){
 const mod=v24Mod();
 const perfect=!chain&&Math.hypot(x-o.x,y-o.y)<o.r*game.perfectWindow;
 /* FLUX resonance. V21 blocks a warded target by reading `o.v21Warded`, so lowering the flag for
    the duration of this one call is the whole implementation — and it stays honest, because the
    ward is restored immediately and every other tap still meets it. */
 const pierced=mod.pierce&&perfect&&o.v21Warded&&typeof v21WardUp==='function'&&v21WardUp(o);
 if(pierced){o.v21Warded=false;ring(o.x,o.y,'#61efff',24);}
 const wasAlive=game.orbs.includes(o);
 const scoreBefore=game.score;
 v24HitBase(o,x,y,chain);
 if(pierced)o.v21Warded=true;
 const killed=wasAlive&&!game.orbs.includes(o);
 const gained=game.score-scoreBefore;

 /* Heat adjustments are applied as the difference from what V21 already did, so this layer never
    has to know the order the vents happened in. */
 if(!chain){
  if(perfect&&mod.perfectVent!==1)v21Vent(V21_HEAT.ventPerfect*(mod.perfectVent-1));
  if(killed&&mod.killVent!==1){
   const delta=V21_HEAT.ventKill*(1-mod.killVent);
   if(delta>0)v21AddHeat(delta);
  }
 }

 if(killed){
  let bonus=0;
  if(perfect&&mod.perfectScore>0)bonus+=gained*mod.perfectScore;
  /* Measured from the reactor line rather than the screen centre: the lower half of the *arena*
     is what the player is actually gambling with. */
  if(mod.lowScore>0&&o.y>v22Line()*.55)bonus+=gained*mod.lowScore;
  if(bonus>0){
   game.score+=Math.round(bonus);
   floating(o.x,o.y-26,'+'+format(Math.round(bonus)),'#ffe15c');
  }
  if(o.type==='shard'&&mod.runnerKill>1){
   const extra=Math.round(3*(mod.runnerKill-1));
   game.shardsEarned+=extra;
   save.shards+=extra;
   persist();
   game.score+=Math.round(400*(mod.runnerKill-1));
   floating(o.x,o.y-44,`BOUNTY +${extra}◈`,'#7dffb0');
  }
  const dir=v24Directive();
  if(dir&&!dir.resolved){
   if(dir.id==='perfect'&&perfect)dir.progress++;
   if(dir.id==='chain'){
    dir.run=(game.elapsed-dir.lastKill<=V24_CHAIN_WINDOW)?dir.run+1:1;
    dir.lastKill=game.elapsed;
    dir.best=Math.max(dir.best,dir.run);
    dir.progress=dir.best;
   }
  }
 }
};

/* A breach is a breach whatever caused it — a hostile at the line, a runner leaving with the
   haul, or a boss shot landing — so both paths are watched. The salvage net sits here rather
   than inside `damage()` alone because a runner never calls `damage()` at all, and a net that
   let runners past would be a net with a hole in exactly the wave that cares about them. */
function v24Breach(){
 const dir=v24Directive();
 if(dir&&!dir.resolved&&dir.id==='breach')dir.failed=true;
}

function v24NetCatch(){
 const mod=v24Mod();
 if(!mod.net||!game.v24||game.v24.netUsed)return false;
 game.v24.netUsed=true;
 toast('SALVAGE NET HELD');
 ring(W/2,v22Line()-16,'#7dffb0',44);
 audio.sfx('shield');
 return true;
}

const v24DamageBase=damage;
damage=function(){
 if(!v24Live())return v24DamageBase();
 if(v24NetCatch())return;
 v24Breach();
 v24DamageBase();
};

const v24LandedBase=v22Landed;
v22Landed=function(o){
 if(!v24Live())return v24LandedBase(o);
 if(o.type==='shard'){
  /* The net catches a runner too: it is the wave's first breach, and under NO BREACH a runner
     that leaves is exactly the failure the player is being asked to prevent. */
  if(v24NetCatch()){
   floating(o.x,v22Line()-30,'NET','#7dffb0');
   return;
  }
  v24Breach();
 }
 v24LandedBase(o);
};

/* Bounty's downside. V22_STEAL is a const, so the extra theft is taken as a second bite after
   the base has taken the first — same cap, same rule that banked shards are untouchable. */
const v24EscapeBase=v22Escape;
v22Escape=function(o){
 v24EscapeBase(o);
 const mod=v24Mod();
 const extra=Math.round(V22_STEAL*(mod.runnerSteal-1));
 if(extra<=0)return;
 const steal=Math.min(extra,Math.max(0,game.shardsEarned||0));
 if(steal<=0)return;
 game.shardsEarned-=steal;
 save.shards=Math.max(0,save.shards-steal);
 persist();
 floating(o.x,v22Line()-52,`BOUNTY −${steal}◈`,'#ff8a3d');
};

/* ---- Wave boundaries ------------------------------------------------------------------------ */

const v24CheckWaveBase=checkWave;
checkWave=function(){
 if(v24Live()&&!game.boss&&game.waveKills>=game.waveTarget)v24ResolveDirective();
 v24CheckWaveBase();
};

const v24NextWaveBase=nextWave;
nextWave=function(){
 v24NextWaveBase();
 if(!v24Live())return;
 game.v24.netUsed=false;
 v24StartDirective();
};

/* The streak is where directives are actually paid. A flat bonus is invisible against a score
   that climbs by hundreds of thousands; a multiplier on everything, that has to be defended
   every wave and falls to nothing the moment one is missed, is worth changing how you play for. */
const v24ScoreBase=score;
score=function(delta,event='hit'){
 const streak=game.v24?game.v24.streak:0;
 v24ScoreBase(streak?delta*(1+streak*V24_STREAK.step):delta,event);
};

/* ---- Reactor hooks -------------------------------------------------------------------------- */

const v24AddHeatBase=v21AddHeat;
v21AddHeat=function(amount){
 const mod=v24Mod();
 /* The tap handler passes one of exactly three constants, so the kind of tap can be read off the
    amount. Threading a reason parameter through V21's handler would be cleaner and would mean
    editing a file this layer does not own; the constants are unambiguous and a mismatch would be
    caught by the blocked tap simply costing heat again. */
 if(mod.blockFree&&amount===V21_HEAT.blocked)return;
 v24AddHeatBase(amount);
 /* TIME FURNACE gives up V23's 45% discount on deferred heat. V23's wrapper has already banked
    the discounted share, so what is added here is the rest of the bill. */
 if(mod.odDebtFull&&game.overdriveTime>0&&typeof V23_OD==='object')
  game.v23Debt=Math.min(V21_HEAT.max,(game.v23Debt||0)+amount*(1-V23_OD.debt));
};

const v24OverheatBase=v21Overheat;
v21Overheat=function(){
 v24OverheatBase();
 const mod=v24Mod();
 if(mod.lockout!==1)game.v21Lock*=mod.lockout;
};

/* Ward cycles are read through this one function everywhere, so speeding the clock up for a
   player who bought HARMONIC SYNC is a change to the reading, not to the enemy. Nothing about
   which hostile is on screen or where it is moves — which is what keeps it out of V20's way. */
const v24WardPhaseBase=v21WardPhase;
v21WardPhase=function(o){
 const rate=v24Mod().wardRate;
 if(rate===1)return v24WardPhaseBase(o);
 const cycle=V21_WARD.open+V21_WARD.closed;
 return ((game.elapsed*rate+o.v21WardOffset)%cycle+cycle)%cycle;
};

/* ---- Blast hooks ---------------------------------------------------------------------------- */

const v24CoverageBase=v23BlastCoverage;
v23BlastCoverage=function(charge){return Math.min(1,v24CoverageBase(charge)*v24Mod().blastReach);}

const v24BlastBase=activateBlast;
activateBlast=function(){
 const mod=v24Mod();
 const charge=Math.min(V23_BLAST.max,game.blast);
 const armed=game.running&&!game.paused&&game.blast>=V23_BLAST.min;
 const heat=game.v21Heat,lock=game.v21Lock;
 const reach=H*v23BlastCoverage(charge);
 const caught=armed?game.orbs.filter((o)=>o.y>v22Line()-reach).length:0;
 v24BlastBase();
 if(!armed||game.blast!==0)return;
 /* SINGULARITY CELL. V23 zeroes heat inside the discharge on purpose — firing always leaves you
    able to shoot. Giving that up is the price of the extra reach, and it is restored here rather
    than by rewriting the ability, so the two stay in step if V23's numbers move. */
 if(!mod.blastCools){game.v21Heat=heat;game.v21Lock=lock;}
 /* VOLT resonance. Deliberately conditional on the discharge being a good one: V23 removed
    Blast's self-charging because an ability that pays for itself is not a resource, and a refund
    that only lands on a six-hostile clump pays for the waiting rather than for the pressing. */
 if(mod.blastRefund>0&&caught>=6){
  game.blast=Math.min(V23_BLAST.max,charge*mod.blastRefund);
  floating(W*.5,v22Line()-70,'CAPACITOR FEEDBACK','#ffb02e');
 }
};

/* ---- The augment screen ---------------------------------------------------------------------
   Replaced rather than wrapped: the offer rules are the point of the rework, and calling through
   would build the old three-random-cards grid first. */

function v24Shuffle(list){return list.slice().sort(()=>rng()-.5);}

/* An offer has to contain a card worth continuing your build with and a card worth abandoning it
   for, or the pick is decided by the shuffle rather than by the player. With no augments yet
   there is no build to continue, so the only rule is that all three come from different families
   — the first pick is where a run chooses what it wants to be. */
function v24Offer(){
 const counts=game.v24.counts||{};
 const lead=Object.keys(counts).sort((a,b)=>counts[b]-counts[a])[0];
 const shuffled=v24Shuffle(V24_AUGMENTS);
 const picks=[];
 const take=(test)=>{
  const found=shuffled.find((a)=>!picks.includes(a)&&test(a));
  if(found)picks.push(found);
  return found;
 };
 if(lead)take((a)=>a.family===lead);
 if(!picks.length)take(()=>true);
 take((a)=>a.family!==picks[0].family);
 take((a)=>!picks.some((p)=>p.family===a.family));
 while(picks.length<3)take(()=>true);
 return picks.slice(0,3);
}

const v24AugmentTitle=$('augmentScreen').querySelector('h2');

/* Held in a variable rather than looked up by id: the element is created here, so it is not in
   index.html, and the client validator quite rightly refuses to ship a `$()` lookup for an id
   the markup does not define. */
let v24Strip=null;
function v24BuildStrip(){
 const strip=v24Strip||(v24Strip=document.createElement('div'));
 if(!strip.parentNode){
  strip.style.cssText='display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin:-8px 0 18px;font-weight:900;font-size:11px;letter-spacing:.14em';
  $('augmentGrid').before(strip);
 }
 strip.innerHTML='';
 const counts=game.v24.counts||{};
 for(const key of Object.keys(V24_FAMILIES)){
  const family=V24_FAMILIES[key];
  const held=counts[key]||0;
  const chip=document.createElement('span');
  chip.style.cssText=`padding:6px 10px;border-radius:999px;border:1px solid ${family.color}${held?'':'33'};color:${held?family.color:'#7f93a6'};opacity:${held?1:.6}`;
  chip.textContent=`${family.name} ${'●'.repeat(held)}${'○'.repeat(Math.max(0,2-held))}${held>=2?' ⚡':''}`;
  chip.title=family.resonance;
  strip.append(chip);
 }
 return strip;
}

chooseAugment=function(){
 if(!game.v24){game.v24={mod:v24DefaultMod(),augments:[],counts:{},streak:0,cred:0,met:0,missed:0,dir:null,netUsed:false};}
 game.paused=true;
 const picks=v24Offer();
 const counts=game.v24.counts||{};
 const lead=Object.keys(counts).sort((a,b)=>counts[b]-counts[a])[0];
 /* The elevated card is drawn from outside the lead family on purpose. Elevating the card the
    player was going to take anyway would turn a commendation into a rebate; elevating the one
    that pulls them off their build is what makes it a decision. */
 let elevated=null;
 if(game.v24.cred>=V24_COMMEND){
  elevated=picks.find((a)=>a.family!==lead)||picks[0];
  game.v24.cred-=V24_COMMEND;
 }
 v24BuildStrip();
 if(v24AugmentTitle)v24AugmentTitle.textContent=game.v24.augments.length?'EXTEND THE BUILD':'CHOOSE AN AUGMENT';
 const grid=$('augmentGrid');
 grid.innerHTML='';
 for(const augment of picks){
  const isElevated=augment===elevated;
  const family=V24_FAMILIES[augment.family];
  const held=counts[augment.family]||0;
  const card=document.createElement('button');
  card.className='augment-card';
  /* Exposed on the element rather than only in the label so the card can be identified without
     parsing display text — the bot harness reads these, and so does anything that later wants to
     remember a build. */
  card.dataset.aug=augment.id;
  card.dataset.augFamily=augment.family;
  card.dataset.augElevated=isElevated?'1':'0';
  card.style.borderLeft=`4px solid ${family.color}`;
  if(isElevated){
   card.style.boxShadow=`0 0 26px ${family.color}55`;
   card.style.borderColor='#ffe15c';
  }
  const resonance=held===1?`<small style="display:block;margin-top:8px;color:${family.color}">RESONANCE: ${family.resonance}</small>`:'';
  card.innerHTML=`<span style="display:block;font-size:10px;letter-spacing:.2em;font-weight:900;color:${family.color}">${family.name}${isElevated?' • ELEVATED':''}</span>`+
   `<b>${augment.name}</b><p>${augment.desc(isElevated?V24_ELEVATED:1)}</p>${resonance}<small>INSTALL</small>`;
  card.onclick=()=>{
   v24Install(augment,isElevated);
   showScreen(null);
   game.paused=false;
   toast(`${augment.name} INSTALLED`);
   haptic(15);
  };
  grid.append(card);
 }
 showScreen('augmentScreen');
};

/* ---- Readouts --------------------------------------------------------------------------------
   The directive rides on the objective row that already exists rather than adding chrome. A
   player looking at the top of the screen is looking away from the hostiles falling into it, so
   the requirement is condensed to a glyph and two numbers. */

const v24HudBase=updateHud;
updateHud=function(){
 v24HudBase();
 if(!v24Live()||!game.v24)return;
 const dir=game.v24.dir;
 if(!dir)return;
 const streak=game.v24.streak;
 const detail=dir.short?dir.short(dir):'';
 const text=$('cbObjectiveText');
 if(text&&detail)text.textContent=`${Math.min(game.waveKills,game.waveTarget)}/${game.waveTarget} · ${detail}`;
 const label=$('directiveLabel');
 if(label)label.textContent=`${dir.name}${detail?' • '+detail:''}${streak?` • x${(1+streak*V24_STREAK.step).toFixed(2)}`:''}`;
 const bar=$('combatBar');
 if(bar){
  bar.dataset.objective=dir.name;
  bar.dataset.streak=streak;
 }
};

/* NO BREACH is the only directive that changes what a hostile is worth, so it is the only one
   that needs marking on the field: a runner the player is normally allowed to give up becomes
   the thing that ends the streak. Drawn as a warning on the escape route V22 already draws. */
v19OrbOverlays.push((o)=>{
 const dir=v24Directive();
 if(!dir||dir.id!=='breach'||dir.failed||o.type!=='shard')return;
 ctx.save();
 ctx.globalAlpha=.5+Math.sin(game.elapsed*7)*.25;
 ctx.strokeStyle='#ff8a3d';
 ctx.lineWidth=2;
 ctx.beginPath();
 ctx.arc(o.x,o.y,o.r+9,0,Math.PI*2);
 ctx.stroke();
 ctx.restore();
});

/* ---- Reactor decay --------------------------------------------------------------------------
   Applied as a correction after the base has vented its own share, so the multiplier lands on
   V21's number wherever V21 chooses to change it. A card that slows venting adds the difference
   back through the real heat path rather than writing the gauge directly: sitting at the ceiling
   with a slow reactor has to be able to overheat you, or the downside is not one. */
const v24UpdateBase=update;
update=function(dt){
 v24UpdateBase(dt);
 if(!game.running||game.paused)return;
 const mod=v24Mod();
 if(mod.decay===1||game.v21Lock>0)return;
 const delta=V21_HEAT.decay*(mod.decay-1)*dt;
 if(delta>0)v21Vent(delta);
 else if(game.v21Heat>0)v21AddHeat(-delta);
};
