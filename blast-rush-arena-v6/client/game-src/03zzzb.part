/* V80 — hang the printed chrome off one class.

   `v80-print.css` is scoped entirely under `html.v77-print`, so the old glass chrome survives
   untouched underneath and the switch stays a switch. This is the code that sets the class.

   Applied at load AND kept in step every frame, which is not belt-and-braces -- the first version
   did it only inside `draw`, and `draw` does not run outside a game. Photographed, the launch
   screen, the stage select, the armory and the results screen all came back in the old glass while
   the arena was printed: every screen a player sees before they press PLAY was unconverted, which
   is the worst possible half of the conversion to be missing. The per-frame check stays because
   `V77.on` is a plain field and the whole value of it is flipping it live -- from a harness, from a
   console, from a settings toggle later -- and seeing both looks without a reload. */

function v80Sync(){
 const want=!!V77.on;
 const root=document.documentElement;
 if(root.classList.contains('v77-print')!==want)root.classList.toggle('v77-print',want);
}

v80Sync();

const v80Draw=draw;
draw=function(){
 v80Sync();
 return v80Draw();
};

/* Menus do not draw, but they do refresh their readouts, so this is where a screen outside the
   arena picks the class up if the switch is thrown while one is open. */
const v80Hud=updateHud;
updateHud=function(){
 v80Sync();
 return v80Hud();
};
