    $('retryButton').addEventListener('click', () => startGame({ mode: game.runMode === 'duel' ? 'solo' : game.runMode, seed: game.runMode === 'challenge' ? game.seed : undefined, challenge: game.challenge }));
    $('homeButton').addEventListener('click', goHome);
    $('gameOverHomeButton').addEventListener('click', goHome);
    $('challengeHomeButton').addEventListener('click', goHome);
    $('blastButton').addEventListener('click', activateBlast);
    $('pressureButton').addEventListener('click', activatePressure);
    $('fullscreenButton').addEventListener('click', toggleFullscreen);
    $('shareRoomButton').addEventListener('click', shareRoom);
    $('copyRoomButton').addEventListener('click', copyRoomCode);
    $('leaveLobbyButton').addEventListener('click', leaveLobby);
    $('shareChallengeButton').addEventListener('click', shareScoreChallenge);
    $('rematchButton').addEventListener('click', () => { BlastNetwork.rematch(); $('rematchButton').disabled = true; $('rematchButton').textContent = 'WAITING FOR RIVAL…'; });
    $('acceptChallengeButton').addEventListener('click', () => startGame({ mode: 'challenge', seed: game.challenge.seed, challenge: game.challenge }));
    $('playerNameInput').value = BlastNetwork.playerName;
    $('playerNameInput').addEventListener('change', (e) => { e.target.value = BlastNetwork.setName(e.target.value); updateMenu(); });

    document.querySelectorAll('[data-close]').forEach(btn => btn.addEventListener('click', () => closeOverlay(btn.dataset.close)));
    $('soundToggle').addEventListener('change', (e) => changeSetting('sound', e.target.checked));
    $('musicToggle').addEventListener('change', (e) => changeSetting('music', e.target.checked));
    $('comfortToggle').addEventListener('change', (e) => changeSetting('comfort', e.target.checked));
    $('shakeToggle').addEventListener('change', (e) => changeSetting('shake', e.target.checked));

    canvas.addEventListener('pointerdown', onPointerDown);
    canvas.addEventListener('pointermove', (e) => setPointer(e));
    canvas.addEventListener('contextmenu', (e) => e.preventDefault());
    addEventListener('keydown', onKeyDown);
    addEventListener('resize', resize);
    document.addEventListener('visibilitychange', () => { if (document.hidden && game.mode === 'playing' && game.runMode !== 'duel') pauseGame(); });
  }

  function changeSetting(key, value) {
    save.settings[key] = value;
    persist();
    if (key === 'music') value ? startMusic() : stopMusic();
    if (key === 'sound' && value) sound('select');
  }

  function updateSettingsUi() {
    $('soundToggle').checked = save.settings.sound;
    $('musicToggle').checked = save.settings.music;
    $('comfortToggle').checked = save.settings.comfort;
    $('shakeToggle').checked = save.settings.shake;
  }

  function resize() {
    game.dpr = Math.min(devicePixelRatio || 1, 2);
    game.width = innerWidth;
    game.height = innerHeight;
    canvas.width = Math.floor(game.width * game.dpr);
    canvas.height = Math.floor(game.height * game.dpr);
    canvas.style.width = `${game.width}px`;
    canvas.style.height = `${game.height}px`;
    ctx.setTransform(game.dpr, 0, 0, game.dpr, 0, 0);
    initSpace();
  }

  function initSpace() {
    game.stars = Array.from({ length: Math.floor((game.width * game.height) / 6200) }, () => ({
      x: Math.random() * game.width, y: Math.random() * game.height,
      z: .25 + Math.random() * .75, tw: Math.random() * Math.PI * 2
    }));
    game.nebulae = Array.from({ length: 7 }, () => ({
      x: Math.random() * game.width, y: Math.random() * game.height * .75,
      r: 160 + Math.random() * 300, hue: [205, 225, 270, 300][Math.floor(Math.random() * 4)], a: .04 + Math.random() * .08
    }));
  }

  function startGame(options = {}) {
    ensureAudio();
    closeAllScreens();
    ui.hud.classList.remove('hidden');
    game.mode = 'playing';
    game.runMode = options.mode || 'solo';
    game.seed = Number(options.seed || cryptoSeed());
    game.rngState = game.seed >>> 0 || 1;
    game.challenge = options.challenge || null;
    game.duel = options.duel || null;
    game.score = 0; game.lives = 3; game.wave = 1; game.killsThisWave = 0; game.waveTarget = 13;
    game.combo = 0; game.maxCombo = 0; game.comboTimer = 0;
    game.overdrive = 0; game.overdriveActive = false; game.overdriveTime = 0;
    game.blast = 0; game.pressure = 0; game.shield = 0; game.destroyed = 0; game.perfects = 0; game.chains = 0;
    game.runShards = 0; game.runXp = 0; game.missionProgress = 0; game.missionComplete = false;
    game.spawnTimer = 0; game.nextSpawn = .65; game.boss = null; game.waveTransition = false;
    game.shake = 0; game.flash = 0; game.slowMo = 1; game.hazard = null;
    game.orbs.length = 0; game.particles.length = 0; game.shockwaves.length = 0; game.floatingTexts.length = 0;
    game.augments = { chain: 0, perfect: 0, overdrive: 0, blast: 0, score: 0, shield: 0 };
    configureWave(true);
    ui.duelPanel.classList.toggle('hidden', game.runMode !== 'duel');
    ui.pressureButton.classList.toggle('hidden', game.runMode !== 'duel');
    ui.challengeTarget.classList.toggle('hidden', game.runMode !== 'challenge');
    $('bestScoreLine').classList.toggle('hidden', game.runMode === 'duel');
    $('shareChallengeButton').classList.toggle('hidden', game.runMode === 'duel');
    if (game.challenge) {
      $('challengeTargetName').textContent = game.challenge.creatorName;
      $('challengeTargetScore').textContent = format(game.challenge.score);
    }
    startMusic();
    sound('start');
    showStageBanner();
    updateHud();
  }

  function pauseGame() {
    if (game.mode !== 'playing') return;
    game.mode = 'paused';
    showScreen('pauseScreen');
    setMusicIntensity(.25);
  }

  function resumeGame() {
    if (game.mode !== 'paused') return;
    closeAllScreens();
    ui.hud.classList.remove('hidden');
    game.mode = 'playing';
    game.lastTime = performance.now();
    setMusicIntensity(game.overdriveActive ? 1 : .65);
  }

  function goHome() {
    if (game.runMode === 'duel') BlastNetwork.leave();
    game.mode = 'menu'; game.runMode = 'solo'; game.duel = null; game.challenge = null;
    ui.hud.classList.add('hidden');
    game.orbs.length = 0;
    clearHazard();
    stopMusic();
    updateMenu();
    showScreen('menuScreen');
  }

  function showScreen(id) {
    document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
    $(id).classList.add('active');
  }

  function showOverlay(id, overPause = false) {
    if (game.mode === 'playing') game.mode = 'paused';
    if (!overPause) document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
    $(id).classList.add('active');
  }

  function closeOverlay(id) {
    $(id).classList.remove('active');
    if (game.mode === 'paused' && ui.hud.classList.contains('hidden')) {
      showScreen('menuScreen');
      game.mode = 'menu';
    } else if (game.mode === 'paused') {
      showScreen('pauseScreen');
    }
  }

  function closeAllScreens() {
    document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  }

  function updateMenu() {
    $('menuLevel').textContent = save.level;
    $('menuHighScore').textContent = format(save.highScore);
    $('menuBestWave').textContent = save.bestWave;
    $('menuShards').textContent = format(save.shards);
    $('dailyMissionText').textContent = save.dailyClaimed ? `${mission.text} — COMPLETE` : mission.text;
    $('dailyRewardText').textContent = mission.reward;
    $('playerNameInput').value = BlastNetwork.playerName;
  }

  function onKeyDown(e) {
    if (e.repeat) return;
    const key = e.key.toLowerCase();
    if (key === 'f') toggleFullscreen();
    if (key === 'p' || e.key === 'Escape') {
      if (game.mode === 'playing' && game.runMode !== 'duel') pauseGame();
      else if (game.mode === 'paused' && $('pauseScreen').classList.contains('active')) resumeGame();
    }
    if (game.mode !== 'playing') return;
    if (e.code === 'Space') { e.preventDefault(); activateOverdrive(); }
    if (key === 'b') activateBlast();
    if (key === 'q') activatePressure();
  }

  function setPointer(e) {
    const r = canvas.getBoundingClientRect();
    game.pointer.x = (e.clientX - r.left) * game.width / r.width;
    game.pointer.y = (e.clientY - r.top) * game.height / r.height;
  }

  function onPointerDown(e) {
    setPointer(e);
    if (game.mode !== 'playing') return;
    ensureAudio();
