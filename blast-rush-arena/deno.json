{
  "tasks": {
    "dev": "deno run --allow-net --allow-read --allow-write --allow-env --unstable-kv --watch=server,client/game-src,scripts server/main.ts",
    "start": "deno run --allow-net --allow-read --allow-write --allow-env --unstable-kv server/main.ts",
    "check": "deno check --unstable-kv server/main.ts server/matchmaker.ts server/store.ts scripts/build_client.ts client/net.js client/game.js",
    "fmt": "deno fmt",
    "test": "deno test --allow-read --unstable-kv server/",
    "build": "deno run --allow-read --allow-write scripts/build_client.ts"
  },
  "compilerOptions": {
    "strict": true,
    "lib": [
      "deno.window",
      "dom",
      "dom.iterable",
      "es2023"
    ]
  },
  "unstable": [
    "kv"
  ],
  "deploy": {
    "runtime": {
      "type": "dynamic",
      "entrypoint": "server/main.ts"
    },
    "build": "deno task build"
  }
}
